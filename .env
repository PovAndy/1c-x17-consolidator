# Минимальная конфигурация для запуска локальных скриптов.
# Заполните значения под своё окружение. Секреты и конфиденциальные данные сюда не вносите.

# Linux/vrunner
V8_BIN=/opt/1cv8/x86_64/8.3.XX.XXXX/1cv8
IB_CONN=/F/PATH_TO_BASE

# Windows bridge baseline
V8_WIN_BIN=C:\Program Files\1cv8\8.3.XX.XXXX\bin\1cv8.exe
V8_VERSION=
LANG=ru
BITNESS=x64

# Учётные данные заполняются локально (пустые значения по умолчанию)
EPF_DB_USER=
EPF_DB_PWD=
DB_USER=
DB_PWD=

# Read-only PostgreSQL диагностика (заполнить локально)
EPF_SQL_RO_USER=
EPF_SQL_RO_PWD=
EPF_SQL_RO_HOST=
EPF_SQL_RO_PORT=5432
EPF_SQL_RO_SCHEMA=public