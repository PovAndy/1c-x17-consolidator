# Required
GEMINI_1PSID=PASTE_REAL_VALUE_HERE
GEMINI_1PAPISID=PASTE_REAL_VALUE_HERE

# Optional, but recommended if available from browser cookies
GEMINI_1PSIDTS=

# Optional network override if Google temporarily blocks the current IP
# Example: http://127.0.0.1:8080 or socks5://127.0.0.1:1080
GEMINI_PROXY=
