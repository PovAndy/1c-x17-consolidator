Процедура ИсправитьОсновныеХарактеристикиЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ОчиститьСообщения();
	Состояние("Выполняется исправление основных характеристик. Пожалуйста, подождите...");

	Если Адапт_ЗапуститьДолгуюОперациюВФоновомРежиме("ИсправитьОсновныеХарактеристикиНаСервере") Тогда
		Возврат;
	КонецЕсли;

	РезультатИсправления = ИсправитьОсновныеХарактеристикиНаСервере();
	Если РезультатИсправления = Неопределено Тогда
		СообщитьПользователю("Не удалось получить результат исправления основных характеристик.");
		Возврат;
	КонецЕсли;

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("md");
	ТекстовыйФайл = Новый ЗаписьТекста(ИмяВременногоФайла, КодировкаТекста.UTF8);
	ТекстовыйФайл.Записать(РезультатИсправления.ПолныйОтчет);
	ТекстовыйФайл.Закрыть();

	ЗаголовокОповещения = ?(РезультатИсправления.БылиИзменения, "Основные характеристики исправлены", "Изменения не потребовались");
	ПоказатьОповещениеПользователя(ЗаголовокОповещения, , РезультатИсправления.КраткийИтог + Символы.ПС + ИмяВременногоФайла);
	ЗапуститьПриложение(ИмяВременногоФайла);

