Процедура Адапт_СвязиКлючейАналитикиКлючАналитикиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	ИсключаемыеТипы = Новый Массив;
	ИсключаемыеТипы.Добавить("РегистрыСведений");
	ИсключаемыеТипы.Добавить("РегистрыНакопления");
	ИсключаемыеТипы.Добавить("РегистрыБухгалтерии");
	ИсключаемыеТипы.Добавить("РегистрРасчета");

	СтандартнаяОбработка = Ложь;

	ТекДанные = Элементы.СвязиКлючейАналитики.ТекущиеДанные;
	ТипОбъекта = ТекДанные.КлючАналитики;

	ДополнительныеПараметры = Новый Структура("Элемент", Элемент);
	ПараметрыОткрытия = Новый Структура("ТипОбъекта, ИсключаемыеТипы", ТипОбъекта, ИсключаемыеТипы);
	ОписаниеОповещения = Новый ОписаниеОповещения("Адапт_СвязиКлючейАналитики_КлючАналитикиНачалоВыбораЗавершение", ЭтотОбъект, ДополнительныеПараметры);


	Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;

	ИмяФормыВыбораТипа = Адапт_ПолноеИмяФормы("ФормаВыбораТипа");
	ОткрытьФорму(ИмяФормыВыбораТипа, ПараметрыОткрытия, ЭтотОбъект, , , , ОписаниеОповещения, Режим);

КонецПроцедуры

&НаКлиенте
Процедура Адапт_СвязиКлючейАналитики_КлючАналитикиНачалоВыбораЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт

	Перем Элемент, ОписаниеТипа, Представление;

	Если РезультатВыполнения = Неопределено Тогда
		Элементы.СвязиКлючейАналитикиКлючАналитики.ВыбиратьТип = Истина;
		Возврат;
	КонецЕсли;

	ОписаниеТипов = РезультатВыполнения.ОписаниеТипов;
	Представление = Адапт_СтроковоеПредставлениеТипа(ОписаниеТипов);

	Элемент = ДополнительныеПараметры.Элемент;

	Элемент.ВыбиратьТип = (ОписаниеТипов.Типы().Количество() > 1);
	Элемент.КартинкаКнопкиВыбора = Новый Картинка;
	Элемент.КнопкаВыбора = Истина;
	Элемент.КнопкаОткрытия = Неопределено;
	Элемент.ОграничениеТипа = Новый ОписаниеТипов("Строка");
	Элемент.РедактированиеТекста = Ложь;
	Элемент.КнопкаВыпадающегоСписка = Неопределено;

	ТекДанные = Элементы.СвязиКлючейАналитики.ТекущиеДанные;
	ТекДанные.КлючАналитики = Представление;
	ТекДанные.КлючАналитикиМетаданныеОк = Истина;
	Элементы.СвязиКлючейАналитики.ЗакончитьРедактированиеСтроки(Ложь);

