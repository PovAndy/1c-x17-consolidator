&НаСервере
Процедура Адапт_ЗаполнитьТЧДополнительныеСведения()

	Если Метаданные.ОпределяемыеТипы.Найти("ВладелецДополнительныхСведений") <> Неопределено Тогда
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ОбъектВыгрузки", "ОпределяемыйТип.ВладелецДополнительныхСведений");

		НайденныеСтроки = ДополнительныеСведения.НайтиСтроки(СтруктураОтбора);
		Если НайденныеСтроки.Количество() > 0 Тогда
			Возврат;
		КонецЕсли;

		НоваяСтрока = ДополнительныеСведения.Добавить();
		НоваяСтрока.ОбъектВыгрузки = "ОпределяемыйТип.ВладелецДополнительныхСведений";
		НоваяСтрока.РегистрСведений = "ДополнительныеСведения";
		НоваяСтрока.КлючСвязиСОбъектом = "ДополнительныеСведения.Объект";
	КонецЕсли;

КонецПроцедуры

