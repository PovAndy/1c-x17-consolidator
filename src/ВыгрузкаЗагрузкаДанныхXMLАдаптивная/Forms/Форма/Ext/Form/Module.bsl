	ИначеЕсли ИмяСценария = "preview-service-tariffs" Тогда
		Возврат PreviewВосстановленияТарифовУслугНаСервере();
	ИначеЕсли ИмяСценария = "fix-service-tariffs" Тогда
		Возврат ИсправитьВосстановлениеТарифовУслугНаСервере();
	ИначеЕсли ИмяСценария = "diagnostics-new-meters" Или ИмяСценария = "diag-new-meters" Тогда
