&НаСервере
Функция Адапт_ВыполнитьСценарийАвтозапускаПоИмениНаСервере(ИмяСценария, ПараметрыСценария = Неопределено)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ИмяСценария = НРег(СокрЛП(ИмяСценария));
	ФильтрЛС = "";
	ФильтрДокумента = "";
	Если ПараметрыСценария <> Неопределено Тогда
		ФильтрЛС = СокрЛП(Строка(Адапт_ПолучитьЗначениеИзJSONОбъектаНаСервере(ПараметрыСценария, "ls_filter", "")));
		ФильтрДокумента = СокрЛП(Строка(Адапт_ПолучитьЗначениеИзJSONОбъектаНаСервере(ПараметрыСценария, "doc_filter", "")));
	КонецЕсли;

	Если ИмяСценария = "tis-pipeline-preflight" Тогда
		Возврат ОбработкаОбъект.Адапт_PreflightАвтоконвейераТиС();
	ИначеЕсли ИмяСценария = "diagnostics-viewtypes" Или ИмяСценария = "diag-viewtypes" Тогда
		Возврат ОбработкаОбъект.Адапт_СформироватьОтчетДиагностикиАвтолеченияВидовОбъектов();
	ИначеЕсли ИмяСценария = "preview-viewtypes" Тогда
		Возврат ОбработкаОбъект.Адапт_СформироватьPreviewАвтолеченияВидовОбъектов();
	ИначеЕсли ИмяСценария = "fix-viewtypes" Тогда
		Возврат ОбработкаОбъект.Адапт_ИсправитьВидыОбъектовИХарактеристики();
	ИначеЕсли ИмяСценария = "diagnostics-pvh-dups" Или ИмяСценария = "diag-pvh-dups" Тогда
		Возврат ОбработкаОбъект.Адапт_СформироватьОтчетДиагностикиДублейПВХХарактеристик();
	ИначеЕсли ИмяСценария = "fix-pvh-dups" Тогда
		Возврат ОбработкаОбъект.Адапт_ИсправитьДублиПВХХарактеристик();
	ИначеЕсли ИмяСценария = "diagnostics-pvh-unsafe-live" Или ИмяСценария = "diag-pvh-unsafe-live" Тогда
		Возврат ДиагностикаUnsafeLiveДублейПВХНаСервере();
	ИначеЕсли ИмяСценария = "preview-pvh-unsafe-live" Тогда
		Возврат PreviewUnsafeLiveДублейПВХНаСервере();
	ИначеЕсли ИмяСценария = "fix-pvh-unsafe-live" Тогда
		Возврат ИсправитьUnsafeLiveДублиПВХНаСервере();
	ИначеЕсли ИмяСценария = "diagnostics-meter-catalog-dups" Или ИмяСценария = "diag-meter-catalog-dups" Тогда
		Возврат ДиагностикаДублейСправочниковПриборовНаСервере();
	ИначеЕсли ИмяСценария = "preview-meter-catalog-dups" Тогда
		Возврат PreviewДедупликацииСправочниковПриборовНаСервере();
	ИначеЕсли ИмяСценария = "fix-meter-catalog-dups" Тогда
		Возврат ИсправитьДублиСправочниковПриборовНаСервере();
	ИначеЕсли ИмяСценария = "diagnostics-service-basis" Или ИмяСценария = "diag-service-basis" Тогда
		Возврат ОбработкаОбъект.Адапт_ДиагностикаОснованийРасчетаИПараметровУслуг();
	ИначеЕсли ИмяСценария = "preview-service-basis" Тогда
		Возврат ОбработкаОбъект.Адапт_PreviewОснованийРасчетаИПараметровУслуг();
	ИначеЕсли ИмяСценария = "fix-service-basis" Тогда
		Возврат ОбработкаОбъект.Адапт_ИсправитьОснованияРасчетаИПараметрыУслуг();
	ИначеЕсли ИмяСценария = "diagnostics-service-tariffs" Или ИмяСценария = "diag-service-tariffs" Тогда
		Возврат ОбработкаОбъект.Адапт_ДиагностикаВосстановленияТарифовУслуг();
	ИначеЕсли ИмяСценария = "preview-service-tariffs" Тогда
		Возврат ОбработкаОбъект.Адапт_PreviewВосстановленияТарифовУслуг();
	ИначеЕсли ИмяСценария = "fix-service-tariffs" Тогда
		Возврат ОбработкаОбъект.Адапт_ИсправитьВосстановлениеТарифовУслуг();
	ИначеЕсли ИмяСценария = "diagnostics-new-meters" Или ИмяСценария = "diag-new-meters" Тогда
		Возврат ОбработкаОбъект.Адапт_СформироватьОтчетДиагностикиНовыхСчетчиков(ФильтрЛС, ФильтрДокумента);
	ИначеЕсли ИмяСценария = "preview-new-meters" Тогда
		Возврат ОбработкаОбъект.Адапт_СформироватьPreviewИсправленияНовыхСчетчиков(ФильтрЛС, ФильтрДокумента);
	ИначеЕсли ИмяСценария = "fix-new-meters" Тогда
		Возврат ОбработкаОбъект.Адапт_ИсправитьНовыеСчетчики(ФильтрЛС, ФильтрДокумента);
	ИначеЕсли ИмяСценария = "diagnostics-missing-ipu-recalculations" Или ИмяСценария = "diag-missing-ipu-recalculations" Тогда
		Возврат ОбработкаОбъект.Адапт_СформироватьОтчетДиагностикиПропущенныхПерерасчетовИПУ();
	ИначеЕсли ИмяСценария = "preview-missing-ipu-recalculations" Тогда
		Возврат ОбработкаОбъект.Адапт_СформироватьPreviewПропущенныхПерерасчетовИПУ();
	ИначеЕсли ИмяСценария = "fix-missing-ipu-recalculations" Тогда
		Возврат ОбработкаОбъект.Адапт_СоздатьПропущенныеПерерасчетыИПУ();
	ИначеЕсли ИмяСценария = "diagnostics-gis-folders" Или ИмяСценария = "diag-gis-folders" Тогда
		Возврат ОбработкаОбъект.Адапт_СформироватьОтчетДиагностикиПапокГИСЖКХ();
	ИначеЕсли ИмяСценария = "preview-gis-folders" Тогда
		Возврат ОбработкаОбъект.Адапт_СформироватьPreviewНормализацииПапокГИСЖКХ();
	ИначеЕсли ИмяСценария = "fix-gis-folders" Тогда
		Возврат ОбработкаОбъект.Адапт_ИсправитьПапкиГИСЖКХ();
			ИначеЕсли ИмяСценария = "diagnostics-char-reg-dups" Или ИмяСценария = "diag-char-reg-dups" Тогда
