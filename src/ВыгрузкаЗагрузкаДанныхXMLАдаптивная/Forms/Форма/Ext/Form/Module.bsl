	ИначеЕсли ИмяСценария = "fix-other-chars" Тогда
		Возврат ОбработкаОбъект.Адапт_ВосстановитьПрочиеХарактеристикиПоКарте(АдаптПутьККартеВосстановленияПрочихХарактеристик);
	ИначеЕсли ИмяСценария = "diag-address-ls-services" Или ИмяСценария = "diag-meter-accrual-case" Тогда
		Возврат ОбработкаОбъект.Адапт_СформироватьАдресныйОтчетЛСИУслуг(ФильтрЛС, ФильтрДокумента);
	ИначеЕсли ИмяСценария = "diagnostics-address-ls-street-filters" Или ИмяСценария = "diag-address-ls-street-filters" Тогда
		Возврат ОбработкаОбъект.Адапт_СформироватьОтчетДиагностикиАдресныхФильтровЛС();
	ИначеЕсли ИмяСценария = "preview-address-ls-street-filters" Тогда
		Возврат ОбработкаОбъект.Адапт_СформироватьPreviewИсправленияАдресныхФильтровЛС();
	ИначеЕсли ИмяСценария = "fix-address-ls-street-filters" Тогда
		Возврат ОбработкаОбъект.Адапт_ИсправитьАдресныеФильтрыЛС();
	ИначеЕсли ИмяСценария = "diagnostics-pobedy-street-split" Или ИмяСценария = "diag-pobedy-street-split" Тогда
		Возврат ОбработкаОбъект.Адапт_СформироватьОтчетДиагностикиПобедыАдресныхФильтровЛС();
	ИначеЕсли ИмяСценария = "preview-pobedy-street-split" Тогда
		Возврат ОбработкаОбъект.Адапт_СформироватьPreviewПобедыАдресныхФильтровЛС();
	ИначеЕсли ИмяСценария = "fix-pobedy-street-split" Тогда
		Возврат ОбработкаОбъект.Адапт_ИсправитьПобедыАдресныеФильтрыЛС();
	ИначеЕсли ИмяСценария = "preview-dismissal-bases-36-14" Тогда
