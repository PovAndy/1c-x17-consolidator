&НаСервере
Функция Адапт_ПрочитатьJSONИзФайлаНаСервере(ПутьКФайлу)

	Если ПустаяСтрока(СокрЛП(ПутьКФайлу)) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ТекстовыйФайл = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
		СтрокаJSON = ТекстовыйФайл.Прочитать();
		ТекстовыйФайл.Закрыть();

		Если ПустаяСтрока(СокрЛП(СтрокаJSON)) Тогда
			Возврат Неопределено;
		КонецЕсли;

		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
		ДанныеJSON = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		Возврат ДанныеJSON;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

&НаСервере
Функция Адапт_ПолучитьЗначениеИзJSONОбъектаНаСервере(ДанныеJSON, ИмяПоля, ЗначениеПоУмолчанию = "")

	Если ДанныеJSON = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Попытка
		Если ТипЗнч(ДанныеJSON) = Тип("Структура") Или ТипЗнч(ДанныеJSON) = Тип("ФиксированнаяСтруктура") Тогда
			Если ДанныеJSON.Свойство(ИмяПоля) Тогда
				Возврат ДанныеJSON[ИмяПоля];
			КонецЕсли;
		ИначеЕсли ТипЗнч(ДанныеJSON) = Тип("Соответствие") Или ТипЗнч(ДанныеJSON) = Тип("ФиксированноеСоответствие") Тогда
			Если ДанныеJSON.СодержитКлюч(ИмяПоля) Тогда
				Возврат ДанныеJSON[ИмяПоля];
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

