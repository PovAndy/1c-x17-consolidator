&НаКлиенте
Процедура ИсправитьРазрывыУслугНачисления(Команда)

	Если ПустаяСтрока(
		СокрЛП(АдаптНомерЛСДляАдреснойДиагностики)) Тогда
		СообщитьПользователю(
			"[7.1] Исправление допускается только для одного указанного ЛС.");
		Возврат;
	КонецЕсли;

	Если Не АдаптРазрешитьАдресноеИсправлениеРазрываУслуги Тогда
		СообщитьПользователю(
			"[7.1] Для исправления явно подтвердите, что услуга должна "
				+ "действовать с начала выбранного месяца.");
		Возврат;
	КонецЕсли;

	ТекстВопроса =
		"Будет создан отдельный штатный документ изменения услуг "
			+ "с датой действия на начало выбранного месяца." + Символы.ПС
		+ "Показание ИПУ до официальной даты подключения может быть "
			+ "стартовым и не является автоматическим доказательством." + Символы.ПС
		+ "Вы подтверждаете, что для ЛС "
			+ СокрЛП(АдаптНомерЛСДляАдреснойДиагностики)
			+ " услуга должна действовать с начала выбранного месяца."
			+ Символы.ПС
		+ "Начисления автоматически не перепроводятся. Продолжить?";
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ИсправитьРазрывыУслугНачисленияЗавершение",
		ЭтотОбъект);
	ПоказатьВопрос(
		ОписаниеОповещения,
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ИсправитьРазрывыУслугНачисленияЗавершение(
	Результат,
	ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Адапт_ВыполнитьРазрывыУслугНачисления("fix");

КонецПроцедуры

&НаКлиенте
Процедура Адапт_ВыполнитьРазрывыУслугНачисления(Режим)

	Если Не ЗначениеЗаполнено(АдаптПериодРазрывовУслугНачисления) Тогда
		СообщитьПользователю(
			"[7.1] Укажите месяц начисления для проверки действующих услуг.");
		Возврат;
	КонецЕсли;

	Если АдаптРазрешитьАдресноеИсправлениеРазрываУслуги
		И ПустаяСтрока(СокрЛП(АдаптНомерЛСДляАдреснойДиагностики)) Тогда
		СообщитьПользователю(
			"[7.1] Флаг бизнес-подтверждения можно использовать только "
				+ "при заполненном номере ЛС.");
		Возврат;
	КонецЕсли;

	Режим = НРег(СокрЛП(Строка(Режим)));
	Если Режим = "diagnostic" Тогда
		КодОперации = "ДиагностикаРазрывовУслугНачисленияНаСервере";
	ИначеЕсли Режим = "preview" Тогда
		КодОперации = "PreviewРазрывовУслугНачисленияНаСервере";
	ИначеЕсли Режим = "fix" Тогда
		КодОперации = "ИсправитьРазрывыУслугНачисленияНаСервере";
	Иначе
		СообщитьПользователю(
			"[7.1] Неизвестный режим проверки начислений без услуги: "
				+ Режим);
		Возврат;
	КонецЕсли;

	ОчиститьСообщения();
	Состояние(
		"[7.1] Подготовка анализа услуг расчетного периода. "
			+ "Пожалуйста, подождите...");
	Если Адапт_ЗапуститьДолгуюОперациюВФоновомРежиме(
		КодОперации,
		"",
		АдаптПериодРазрывовУслугНачисления,
		АдаптРазрешитьАдресноеИсправлениеРазрываУслуги) Тогда
		Возврат;
	КонецЕсли;

	Если Режим = "diagnostic" Тогда
		РезультатОперации =
			ДиагностикаРазрывовУслугНачисленияНаСервере();
	ИначеЕсли Режим = "preview" Тогда
		РезультатОперации =
			PreviewРазрывовУслугНачисленияНаСервере();
	Иначе
		РезультатОперации =
			ИсправитьРазрывыУслугНачисленияНаСервере();
	КонецЕсли;

	Если РезультатОперации = Неопределено Тогда
		СообщитьПользователю(
			"[7.1] Операция не вернула результат.");
		Возврат;
	КонецЕсли;
	Адапт_ПоказатьРезультатДолгойОперации(
		РезультатОперации,
		КодОперации);

КонецПроцедуры

&НаКлиенте
Функция Адапт_ЗапуститьДолгуюОперациюВФоновомРежиме(
	КодОперации,
	РежимЭтапа = "",
	ПериодНачисления = Неопределено,
	РазрешитьАдресноеИсправление = Ложь)

	Если Адапт_ВозможнаЗагрузкаВыгрузкаВФоновомРежиме() = Ложь Тогда
		Возврат Ложь;
	КонецЕсли;

	ЗаданиеЗапущено = Ложь;
	Попытка
		ДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайлаОбработки);
		АдресВХОбработки = ПоместитьВоВременноеХранилище(
			ДвоичныеДанные,
			УникальныйИдентификатор);

		ПараметрыЗапуска = Новый Структура;
			ПараметрыЗапуска.Вставить("ИмяФайла", "");
			ПараметрыЗапуска.Вставить("КодОперации", КодОперации);
			ПараметрыЗапуска.Вставить("РежимЭтапа", РежимЭтапа);
			ПараметрыЗапуска.Вставить(
				"ПериодНачисления",
				ПериодНачисления);
			ПараметрыЗапуска.Вставить(
				"РазрешитьАдресноеИсправление",
				РазрешитьАдресноеИсправление);
			ПараметрыЗапуска.Вставить(
				"ФильтрЛС",
				АдаптНомерЛСДляАдреснойДиагностики);
		ПараметрыЗапуска.Вставить(
			"ФильтрДокумента",
			АдаптНомерДокументаДляАдреснойДиагностики);
		ПараметрыЗапуска.Вставить(
			"ПутьККарте",
			АдаптПутьККартеВосстановленияПрочихХарактеристик);
		ПараметрыЗапуска.Вставить(
			"ПутьКЭталону",
			АдаптПутьКЭталонуСтруктурыПомещений);
		ПараметрыЗапуска.Вставить(
			"СписокЛС",
			Адапт_СписокЛСДляПерерасчета);
		ПараметрыЗапуска.Вставить(
			"ЛимитКандидатов",
			Адапт_ЛимитРасхожденийОбъемовИПУ);
		ПараметрыЗапуска.Вставить(
			"ЛимитСоздания",
			Адапт_ЛимитСозданияПерерасчетовИПУ);
		ПараметрыЗапуска.Вставить(
			"НомерПакета",
			Адапт_НомерПилотногоПакетаИПУ);
		ПараметрыЗапуска.Вставить(
			"НомерПакетаДокументов",
			Адапт_НомерДокументногоПакетаИПУ);

		СтруктураФоновогоЗадания =
			Адапт_ВыполнитьФоновоеЗаданиеНаСервере(
				"Восстановление x17: " + КодОперации,
				"Адапт_ВыполнитьДолгуюОперациюВФоне",
				ПараметрыЗапуска,
				"",
				АдресВХОбработки);
		ЗаданиеЗапущено = Истина;

		МодульДлительныеОперацииКлиент =
			Вычислить("ДлительныеОперацииКлиент");
		ПараметрыОжидания =
			МодульДлительныеОперацииКлиент.ПараметрыОжидания(
				ЭтотОбъект);
		ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
		ПараметрыОжидания.ВыводитьСообщения = Истина;
		ПараметрыОжидания.Интервал = 1;
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"Адапт_ВыполнитьДолгуюОперациюВФоновомРежимеЗавершение",
			ЭтотОбъект,
			КодОперации);
		МодульДлительныеОперацииКлиент.ОжидатьЗавершение(
			СтруктураФоновогоЗадания,
			ОписаниеОповещения,
			ПараметрыОжидания);
		Возврат Истина;
	Исключение
		Если ЗаданиеЗапущено Тогда
			СообщитьПользователю(
				"Фоновая операция запущена, но не удалось подключить "
					+ "индикатор ожидания: " + ОписаниеОшибки());
		Иначе
			СообщитьПользователю(
				"Не удалось запустить фоновую операцию; будет использован "
					+ "синхронный резервный режим: " + ОписаниеОшибки());
		КонецЕсли;
		Возврат ЗаданиеЗапущено;
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура Адапт_ВыполнитьДолгуюОперациюВФоновомРежимеЗавершение(
	Результат,
	ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		СообщитьПользователю(
			"Фоновая длительная операция не вернула результат.");
		Возврат;
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда
		СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(Результат.АдресРезультата) Тогда
		СообщитьПользователю(
			"Фоновая длительная операция завершилась без адреса результата.");
		Возврат;
	КонецЕсли;

	РезультатОперации = ПолучитьИзВременногоХранилища(
		Результат.АдресРезультата);
	Если РезультатОперации = Неопределено Тогда
		СообщитьПользователю(
			"Не удалось получить результат длительной операции "
				+ "из временного хранилища.");
		Возврат;
	КонецЕсли;

	Адапт_ПоказатьРезультатДолгойОперации(
		РезультатОперации,
		ДополнительныеПараметры);

КонецПроцедуры

&НаКлиенте
Процедура Адапт_ПоказатьРезультатДолгойОперации(
	РезультатОперации,
	КодОперации)

	Если ТипЗнч(РезультатОперации) <> Тип("Структура") Тогда
		СообщитьПользователю(
			"Длительная операция " + КодОперации
				+ " вернула результат неподдерживаемого типа: "
				+ Строка(ТипЗнч(РезультатОперации)));
		Возврат;
	КонецЕсли;

	КраткийИтог = "";
	ПолныйОтчет = "";
	РасширениеФайла = "md";
	ЕстьПроблемы = Ложь;
	БылиИзменения = Ложь;
	РезультатОперации.Свойство("КраткийИтог", КраткийИтог);
	РезультатОперации.Свойство("ПолныйОтчет", ПолныйОтчет);
	РезультатОперации.Свойство("РасширениеФайла", РасширениеФайла);
	РезультатОперации.Свойство("ЕстьПроблемы", ЕстьПроблемы);
	РезультатОперации.Свойство("БылиИзменения", БылиИзменения);

	Если ПустаяСтрока(СокрЛП(Строка(РасширениеФайла))) Тогда
		РасширениеФайла = "md";
	КонецЕсли;

	ИмяВременногоФайла = "";
	Если Не ПустаяСтрока(Строка(ПолныйОтчет)) Тогда
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла(
			РасширениеФайла);
		ТекстовыйФайл = Новый ЗаписьТекста(
			ИмяВременногоФайла,
			КодировкаТекста.UTF8);
		ТекстовыйФайл.Записать(ПолныйОтчет);
		ТекстовыйФайл.Закрыть();
	КонецЕсли;

	Если ЕстьПроблемы Тогда
		ЗаголовокОповещения =
			"Длительная операция завершена с диагностикой";
	ИначеЕсли БылиИзменения Тогда
		ЗаголовокОповещения =
			"Длительная операция и исправления завершены";
	Иначе
		ЗаголовокОповещения = "Длительная операция завершена";
	КонецЕсли;

	ТекстОповещения = КраткийИтог;
	Если Не ПустаяСтрока(ИмяВременногоФайла) Тогда
		ТекстОповещения = ТекстОповещения
			+ Символы.ПС + ИмяВременногоФайла;
	КонецЕсли;
	Состояние(КраткийИтог);
	ПоказатьОповещениеПользователя(
		ЗаголовокОповещения,
		,
		ТекстОповещения);
	Если Не ПустаяСтрока(ИмяВременногоФайла) Тогда
		ЗапуститьПриложение(ИмяВременногоФайла);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДиагностикаСтруктурыПомещений(Команда)

	ОчиститьСообщения();
	Состояние("Выполняется диагностика структуры помещений. Пожалуйста, подождите...");

