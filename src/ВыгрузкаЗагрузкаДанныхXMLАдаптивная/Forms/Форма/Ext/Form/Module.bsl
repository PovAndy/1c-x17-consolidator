&НаСервере
Процедура Адапт_ПроверитьМетаданныеДопДанных(УстанавливатьКартинку = Ложь)

	СоотвВидовОбъектовЕдМнож = Новый Соответствие;
	СоотвВидовОбъектовЕдМнож.Вставить("Константа",              "Константы");
	СоотвВидовОбъектовЕдМнож.Вставить("Справочник",             "Справочники");
	СоотвВидовОбъектовЕдМнож.Вставить("Документ",               "Документы");
	СоотвВидовОбъектовЕдМнож.Вставить("ПланВидовХарактеристик", "ПланыВидовХарактеристик");
	СоотвВидовОбъектовЕдМнож.Вставить("ПланСчетов",             "ПланыСчетов");
	СоотвВидовОбъектовЕдМнож.Вставить("ПланВидовРасчета",       "ПланыВидовРасчета");
	СоотвВидовОбъектовЕдМнож.Вставить("РегистрСведений",        "РегистрыСведений");
	СоотвВидовОбъектовЕдМнож.Вставить("РегистрНакопления",      "РегистрыНакопления");
	СоотвВидовОбъектовЕдМнож.Вставить("РегистрБухгалтерии",     "РегистрыБухгалтерии");
	СоотвВидовОбъектовЕдМнож.Вставить("РегистрРасчета",         "РегистрыРасчета");
	СоотвВидовОбъектовЕдМнож.Вставить("БизнесПроцесс",          "БизнесПроцессы");
	СоотвВидовОбъектовЕдМнож.Вставить("Задача",                 "Задачи");
	СоотвВидовОбъектовЕдМнож.Вставить("ПланОбмена",             "ПланыОбмена");
	СоотвВидовОбъектовЕдМнож.Вставить("Последовательность",     "Последовательности");
	СоотвВидовОбъектовЕдМнож.Вставить("ОпределяемыйТип",        "ОпределяемыеТипы");

	ЕстьОшибка = Ложь;

	Для каждого СтрокаТЧ Из СвязиКлючейАналитики Цикл
		Если ЗначениеЗаполнено(СтрокаТЧ.КлючАналитики) Тогда
			СтрокаТЧ.КлючАналитикиМетаданныеОк = Адапт_ПроверитьСуществованиеМетаданных(
			СоотвВидовОбъектовЕдМнож,
			СтрокаТЧ.КлючАналитики);
		Иначе
			СтрокаТЧ.КлючАналитикиМетаданныеОк = Ложь;
		КонецЕсли;

		Если ЗначениеЗаполнено(СтрокаТЧ.РегистрДвижений) Тогда
			СтрокаТЧ.РегистрДвиженийМетаданныеОк = Адапт_ПроверитьСуществованиеМетаданных(
			СоотвВидовОбъектовЕдМнож,
			СтрокаТЧ.РегистрДвижений);
		Иначе
			СтрокаТЧ.РегистрДвиженийМетаданныеОк = Ложь;
		КонецЕсли;

		Если НЕ (СтрокаТЧ.КлючАналитикиМетаданныеОк И СтрокаТЧ.РегистрДвиженийМетаданныеОк) Тогда
			ЕстьОшибка = Истина;
		КонецЕсли;

	КонецЦикла;

	Для каждого СтрокаТЧ Из ДополнительныеСведения Цикл
		Если ЗначениеЗаполнено(СтрокаТЧ.ОбъектВыгрузки) Тогда
			СтрокаТЧ.ОбъектВыгрузкиМетаданныеОк = Адапт_ПроверитьСуществованиеМетаданных(
			СоотвВидовОбъектовЕдМнож,
			СтрокаТЧ.ОбъектВыгрузки);
		Иначе
			СтрокаТЧ.ОбъектВыгрузкиМетаданныеОк = Ложь;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТЧ.РегистрСведений) Тогда
			СтрокаТЧ.РегистрСведенийМетаданныеОк = Адапт_ПроверитьСуществованиеМетаданных(
			СоотвВидовОбъектовЕдМнож,
			"РегистрСведений." + СтрокаТЧ.РегистрСведений);
		Иначе
			СтрокаТЧ.РегистрСведенийМетаданныеОк = Ложь;
		КонецЕсли;
		Если СтрокаТЧ.РегистрСведенийМетаданныеОк И ЗначениеЗаполнено(СтрокаТЧ.КлючСвязиСОбъектом) Тогда
			ЧастиИмени = СтрРазделить(СтрокаТЧ.КлючСвязиСОбъектом, ".");
			ИмяРегистра = ЧастиИмени[0];
			ИмяРеквизитаСвязи = ЧастиИмени[1];
			МетаданныеРегистра = Метаданные.РегистрыСведений[ИмяРегистра];
			СтрокаТЧ.КлючСвязиСОбъектомМетаданныеОк = Адапт_ЕстьСвойство(МетаданныеРегистра.Измерения, ИмяРеквизитаСвязи)
				Или Адапт_ЕстьСвойство(МетаданныеРегистра.Ресурсы, ИмяРеквизитаСвязи);
		Иначе
			СтрокаТЧ.КлючСвязиСОбъектомМетаданныеОк = Ложь;
		КонецЕсли;

		Если НЕ (СтрокаТЧ.ОбъектВыгрузкиМетаданныеОк И СтрокаТЧ.РегистрСведенийМетаданныеОк И СтрокаТЧ.КлючСвязиСОбъектомМетаданныеОк) Тогда
			ЕстьОшибка = Истина;
		КонецЕсли;
	КонецЦикла;

	Если ЕстьОшибка Тогда

		Если Элементы.ДвиженияСтраницы.ТекущаяСтраница <> Элементы.ГруппаДополнительныеДанные Тогда
			Элементы.ГруппаДополнительныеДанные.Картинка = БиблиотекаКартинок.НеБеспокоить;
		КонецЕсли;
	Иначе
		Элементы.ГруппаДополнительныеДанные.Картинка = Новый Картинка;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция Адапт_ПроверитьСуществованиеМетаданных(СоотвВидовОбъектовЕдМнож, ОписаниеТипаСтрокой)

	Если ОписаниеТипаСтрокой = "ЛюбаяСсылка" Тогда
		Возврат Истина;
	КонецЕсли;

	ЧастиИмени = СтрРазделить(ОписаниеТипаСтрокой, ".", Ложь);
	ВидОбъекта = ЧастиИмени[0];
	ИмяОбъекта = ЧастиИмени[1];

	ВидОбъектаМнож = СоотвВидовОбъектовЕдМнож[ВидОбъекта];
	//коллекция долго заполняется, строк не много оптимизация не обязательна
	//Поиск = мОписанияТиповКонфигурации[ВидОбъектаМнож][ИмяОбъекта];
	Поиск = Метаданные[ВидОбъектаМнож].Найти(ИмяОбъекта);
	Если Поиск = Неопределено Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;

КонецФункции

