&НаСервереБезКонтекста
Функция Адапт_РеквизитыРегистраСведений(ИмяРегистра, КартинкаИзмерение, КартинкаРесурс)

	СЗ = Новый СписокЗначений;

	выбОбъект = Метаданные.РегистрыСведений[ИмяРегистра];
	Для каждого выбИзмерение Из выбОбъект.Измерения Цикл
		СЗ.Добавить(выбИзмерение.Имя,,,КартинкаИзмерение);
	КонецЦикла;

	Для каждого выбРесурс Из выбОбъект.Ресурсы Цикл
		СЗ.Добавить(выбРесурс.Имя,,,КартинкаРесурс);
	КонецЦикла;

	Возврат СЗ;

КонецФункции


