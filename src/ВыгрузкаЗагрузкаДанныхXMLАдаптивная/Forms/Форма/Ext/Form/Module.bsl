		Возврат;
	КонецЕсли;
	ТекЭлемент = Элемент.ТекущийЭлемент;
	Если ТекЭлемент.Имя = "ДополнительныеОбъектыДляВыгрузкиОбъект" Тогда
		ТекЭлемент.ПодсказкаВвода = ТекДанные.ТипОбъекта;
	КонецЕсли;

КонецПроцедуры

