	//СЗ = Новый СписокЗначений;
	РеквизитыРегистра = Адапт_РеквизитыРегистраСведений(ТекДанные.РегистрСведений, КартинкаИзмерение, КартинкаРесурс);
	//Для каждого КЗ Из РеквизитыРегистра Цикл
	//	НоваяСтрока = СЗ.Добавить();
	//	НоваяСтрока.Значение = КЗ.Ключ;
	//КонецЦикла;

	ОписаниеОповещения = Новый ОписаниеОповещения("Адапт_ДопСведенияВыборРеквизитаЗавершение", ЭтотОбъект);

	ПоказатьВыборИзСписка(ОписаниеОповещения, РеквизитыРегистра);

