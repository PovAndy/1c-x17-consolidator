			ТекстОповещения = Нстр("ru = 'Выполняется загрузка данных. Пожалуйста, подождите...'");
			ПоказатьОповещениеПользователя(ТекстОповещения);
		КонецЕсли;

		// ИСПРАВЛЕНИЕ ОШИБКИ "УКАЗАННЫЙ ФАЙЛ НЕ СУЩЕСТВУЕТ"
		// Проверка закомментирована, так как при пакетной загрузке строка содержит разделители ';'
		//Если Не Адапт_ФайлСуществует(ВыбранноеИмяФайла) Тогда
		//
		//	ТекстСообщения = Нстр("ru = 'Указанный файл не существует'");
		//	ПутьКДанным = ?(РежимРаботыНаКлиенте, "", "ИмяФайлаЗагрузки");
		//	СообщитьПользователю(ТекстСообщения, ПутьКДанным);
		//	Возврат;
		//
		//КонецЕсли;

		Если ЗагружатьВФоновомРежиме И Адапт_ВозможнаЗагрузкаВыгрузкаВФоновомРежиме() Тогда

			Адапт_ЗагрузитьДанныеВФоновомРежиме(Адрес, ВыбранноеИмяФайла);
		Иначе
			ЗагрузитьДанныеНаСервере(Адрес);
			Сигнал();
		КонецЕсли;

