&НаКлиенте
Процедура Адапт_ВыгрузитьДанныеВФоновомРежиме()

	АдресВХФайла = "";

	НаименованиеЗадания = "Фоновое задание Выгрузка данных в XML";
	ИмяМетода           = "Адапт_ВыполнитьВыгрузкуВФоне";

	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайлаОбработки);
	АдресВХОбработки = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);



	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("НаименованиеЗадания",      НаименованиеЗадания);
	СтруктураПараметров.Вставить("ИмяМетода",                ИмяМетода);
	СтруктураПараметров.Вставить("АдресВХФайла",             АдресВХФайла);
	СтруктураПараметров.Вставить("АдресВХОбработки",         АдресВХОбработки);


	СтруктураФоновогоЗадания = Адапт_ВыгрузитьДанныеСервер(СтруктураПараметров);

	МодульДлительныеОперацииКлиент = Вычислить("ДлительныеОперацииКлиент");
    ПараметрыОжидания = МодульДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
    ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ВыводитьСообщения = Истина;
    ПараметрыОжидания.Интервал = 1;

	ОписаниеОповещения = Новый ОписаниеОповещения("Адапт_ВыгрузитьДанныеВФоновомРежимеЗавершение", ЭтотОбъект);

    МодульДлительныеОперацииКлиент.ОжидатьЗавершение(СтруктураФоновогоЗадания, ОписаниеОповещения, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция Адапт_ВыгрузитьДанныеСервер(СтруктураПараметров)

	НаименованиеЗадания = СтруктураПараметров.НаименованиеЗадания;
	ИмяМетода           = СтруктураПараметров.ИмяМетода;
	АдресВХФайла        = СтруктураПараметров.АдресВХФайла;
	АдресВХОбработки    = СтруктураПараметров.АдресВХОбработки;

	Если РежимРаботыНаКлиенте Тогда
		ИмяВременногоФайлаСервер = ПолучитьИмяВременногоФайла("xml");
	Иначе
		ИмяВременногоФайлаСервер = ИмяФайлаВыгрузки;
	КонецЕсли;


	ПараметрыЗапуска = Адапт_ПараметрыВыгрузки(ИмяВременногоФайлаСервер);

	СтруктураФоновогоЗадания = Адапт_ВыполнитьФоновоеЗаданиеНаСервере(НаименованиеЗадания, ИмяМетода, ПараметрыЗапуска, АдресВХФайла, АдресВХОбработки);
	Возврат СтруктураФоновогоЗадания;

КонецФункции

&НаКлиенте
Процедура Адапт_ВыгрузитьДанныеВФоновомРежимеЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда
		СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
		Возврат;
	КонецЕсли;

	Если РежимРаботыНаКлиенте И Не ПустаяСтрока(Результат.АдресРезультата) Тогда

		ИмяФайла = "Файл выгрузки.xml";
		Интерактивно = Истина;
		ПолучитьФайл(Результат.АдресРезультата, ИмяФайла, Интерактивно);

	Иначе

		Сигнал();
		ПоказатьПредупреждение(, "Выгрузка завершена");
	КонецЕсли;

КонецПроцедуры

// Имя процедуры: Адапт_ЗагрузитьДанныеВФоновомРежиме
// Модуль Формы
// Исправляет ошибку "Несоответствие типов" при пакетной загрузке файлов с сервера.
&НаКлиенте
Процедура Адапт_ЗагрузитьДанныеВФоновомРежиме(АдресВХФайла, ПутьКФайлуКлиент)

	// ИСПРАВЛЕНИЕ v112.2: Защита от пустых адресов при пакетной загрузке.
	// Если АдресВХФайла пуст, значит файлы уже на сервере (пакетный выбор).
	Если ПустаяСтрока(АдресВХФайла) Тогда

		ПутьКФайлуНаСервере = ПутьКФайлуКлиент;

	ИначеЕсли Не Адапт_ФайлСуществует(ПутьКФайлуКлиент) Тогда

		// Файл передается с клиента (например, через веб-клиент)
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресВХФайла);
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
		ДвоичныеДанные.Записать(ИмяВременногоФайла);
		ПутьКФайлуНаСервере = ИмяВременногоФайла;

	Иначе

		ПутьКФайлуНаСервере = ПутьКФайлуКлиент;

	КонецЕсли;

	ПараметрыЗапуска = Адапт_ПараметрыЗагрузки(ПутьКФайлуНаСервере);

	// Помещаем саму обработку во временное хранилище для запуска в фоне
	ДвоичныеДанныеОбработки = Новый ДвоичныеДанные(ИмяФайлаОбработки);
	АдресВХОбработки = ПоместитьВоВременноеХранилище(ДвоичныеДанныеОбработки, УникальныйИдентификатор);

	ПараметрыЗадания = Новый Структура();
	ПараметрыЗадания.Вставить("НаименованиеЗадания",      "Фоновое задание Адаптивная загрузка данных из XML");
	ПараметрыЗадания.Вставить("ИмяМетода",                "ВыполнитьЗагрузку");
	ПараметрыЗадания.Вставить("АдресВХФайла",             АдресВХФайла);
	ПараметрыЗадания.Вставить("АдресВХОбработки",         АдресВХОбработки);

	СтруктураФоновогоЗадания = Адапт_ЗагрузитьДанныеСервер(ПараметрыЗадания, ПараметрыЗапуска);

	// Инициализация ожидания через БСП
	МодульДлительныеОперацииКлиент = Вычислить("ДлительныеОперацииКлиент");
    ПараметрыОжидания = МодульДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
    ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ВыводитьСообщения = Истина;
    ПараметрыОжидания.Интервал = 1;

	ОписаниеОповещения = Новый ОписаниеОповещения("Адапт_ЗагрузитьДанныеВФоновомРежимеЗавершение", ЭтотОбъект);

    МодульДлительныеОперацииКлиент.ОжидатьЗавершение(СтруктураФоновогоЗадания, ОписаниеОповещения, ПараметрыОжидания);

// Конец Адапт_ЗагрузитьДанныеВФоновомРежиме
КонецПроцедуры

&НаСервере
Функция Адапт_ЗагрузитьДанныеСервер(ПараметрыЗадания, Знач ПараметрыЗапуска)

	НаименованиеЗадания = ПараметрыЗадания.НаименованиеЗадания;
	ИмяМетода           = ПараметрыЗадания.ИмяМетода;
	АдресВХФайла        = ПараметрыЗадания.АдресВХФайла;
	АдресВХОбработки    = ПараметрыЗадания.АдресВХОбработки;


	СтруктураФоновогоЗадания = Адапт_ВыполнитьФоновоеЗаданиеНаСервере(НаименованиеЗадания, ИмяМетода, ПараметрыЗапуска, АдресВХФайла, АдресВХОбработки);
	Возврат СтруктураФоновогоЗадания;

КонецФункции

&НаСервере
Функция Адапт_ИнициализироватьВсеОбъектыМетаданныхКэш()

	Массив = Новый Массив;
	Массив.Добавить("Константы");
	Массив.Добавить("Справочники");
	Массив.Добавить("Документы");
	Массив.Добавить("ПланыВидовХарактеристик");
	Массив.Добавить("ПланыСчетов");
	Массив.Добавить("ПланыВидовРасчета");
	Массив.Добавить("РегистрыСведений");
	Массив.Добавить("РегистрыНакопления");
	Массив.Добавить("РегистрыБухгалтерии");
	Массив.Добавить("РегистрыРасчета");
	Массив.Добавить("БизнесПроцессы");
	Массив.Добавить("Задачи");
	Массив.Добавить("ПланыОбмена");
	Массив.Добавить("Последовательности");

	ВсеОбъектыМетаданныхКэш = Новый Соответствие;
	ВидыОбъектов = Массив;
	Для каждого ВидМетаданных Из ВидыОбъектов  Цикл
		Для каждого Эл Из Метаданные[ВидМетаданных] Цикл
			ВсеОбъектыМетаданныхКэш.Вставить(Эл, ВидМетаданных);
		КонецЦикла;
	КонецЦикла;

	Возврат ВсеОбъектыМетаданныхКэш;

КонецФункции

&НаСервере
Функция Адапт_ВыполнитьФоновоеЗаданиеНаСервере(НаименованиеЗадания, ИмяМетода, ПараметрыЗапуска, АдресВХФайла, АдресВХОбработки)

	Если АдресВХФайла = "" Тогда //файл находится на сервере
		ПутьКФайлуНаСервере = ПараметрыЗапуска.ИмяФайла;
	Иначе
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресВХФайла);

		ПутьКФайлуНаСервере = ПолучитьИмяВременногоФайла("xml");
		ДвоичныеДанные.Записать(ПутьКФайлуНаСервере);

	КонецЕсли;

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресВХОбработки);
	ПутьКФайлуОбработкиНаСервере = ПолучитьИмяВременногоФайла("epf");
	ДвоичныеДанные.Записать(ПутьКФайлуОбработкиНаСервере);


	ПараметрыЗапуска.ИмяФайла = ПутьКФайлуНаСервере;

    ВыполняемыйМетод = "ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки";

    ПараметрыЗадания = Новый Структура;
    ПараметрыЗадания.Вставить("ИмяОбработки", ПутьКФайлуОбработкиНаСервере);
    ПараметрыЗадания.Вставить("ИмяМетода", ИмяМетода);
    ПараметрыЗадания.Вставить("ПараметрыВыполнения", ПараметрыЗапуска);
    ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка", Истина);

    МодульДлительныеОперации = Вычислить("ДлительныеОперации");
    ПараметрыВыполнения = МодульДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
    ПараметрыВыполнения.НаименованиеФоновогоЗадания = НаименованиеЗадания;
    ПараметрыВыполнения.ЗапуститьВФоне = Истина;
    ПараметрыВыполнения.Вставить("ИдентификаторФормы", УникальныйИдентификатор);

    СтруктураФоновогоЗадания = МодульДлительныеОперации.ВыполнитьВФоне(ВыполняемыйМетод, ПараметрыЗадания, ПараметрыВыполнения);

    Возврат СтруктураФоновогоЗадания;

КонецФункции

