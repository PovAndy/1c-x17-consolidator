&НаСервереБезКонтекста
Функция Адапт_НайтиЗначениеСвойстваВКоллекции(Знач КоллекцияЭлементов, ИмяСвойства, Значение)

	ЭтоДерево = (ТипЗнч(КоллекцияЭлементов) = Тип("ДанныеФормыКоллекцияЭлементовДерева"));

	Для каждого Строка Из КоллекцияЭлементов Цикл
		Если Строка[ИмяСвойства] = Значение Тогда
			Возврат Строка;
		КонецЕсли;

		Если ЭтоДерево = Ложь Тогда
			Продолжить;
		КонецЕсли;

		Подчиненные = Строка.ПолучитьЭлементы();
		Если Подчиненные.Количество() > 0 Тогда
			Найдено = Адапт_НайтиЗначениеСвойстваВКоллекции(Подчиненные, ИмяСвойства, Значение);
			Если Найдено <> Неопределено Тогда
				Возврат Найдено;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

