&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	ПроверитьВерсиюИРежимСовместимостиПлатформы();

	РежимРаботыНаКлиенте = (РежимРаботыНаКлиентеИлиНаСервере = 0);

	Элементы.ИмяФайлаВыгрузки.Доступность = Не РежимРаботыНаКлиенте;
	Элементы.ИмяФайлаЗагрузки.Доступность = Не РежимРаботыНаКлиенте;

	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");


	ОбъектНаСервере.Инициализация();

	ЗначениеВРеквизитФормы(ОбъектНаСервере.ДеревоМетаданных, "Объект.ДеревоМетаданных");



	Файл = Новый Файл(ИмяФайлаВыгрузки);

	РежимВыгрузки = (Элементы.ГруппаРежим.ТекущаяСтраница = Элементы.ГруппаРежим.ПодчиненныеЭлементы.ГруппаВыгрузка);

	//+ Muraviev Sergey 2023.12.08
	Адапт_ПроверитьМетаданныеДопДанных();
	Адапт_УстановитьПредохранительЗагрузкиНаРабочейБазе();
	Адапт_ИнициализироватьНастройкиВыгрузкиЗагрузки();
	Если Не ЗначениеЗаполнено(Адапт_ЛимитСозданияПерерасчетовИПУ) Тогда
		Адапт_ЛимитСозданияПерерасчетовИПУ = 50;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Адапт_НомерПилотногоПакетаИПУ) Тогда
		Адапт_НомерПилотногоПакетаИПУ = 1;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Адапт_НомерДокументногоПакетаИПУ) Тогда
		Адапт_НомерДокументногоПакетаИПУ = 1;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(АдаптПериодРазрывовУслугНачисления) Тогда
		АдаптПериодРазрывовУслугНачисления =
			ДобавитьМесяц(НачалоМесяца(ТекущаяДата()), -1);
	КонецЕсли;
	Если ПустаяСтрока(СокрЛП(АдаптПутьККартеВосстановленияПрочихХарактеристик)) Тогда
		АдаптПутьККартеВосстановленияПрочихХарактеристик = ОбъектНаСервере.Адапт_ПутьККартеВосстановленияПрочихХарактеристикПоУмолчанию();
	КонецЕсли;
	Если ПустаяСтрока(СокрЛП(АдаптПутьКЭталонуСтруктурыПомещений)) Тогда
		АдаптПутьКЭталонуСтруктурыПомещений = ОбъектНаСервере.Адапт_ПутьКЭталонуСтруктурыПомещений();
	КонецЕсли;
	Если Адапт_ПопробоватьВыполнитьАвтозапускНаСервере() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	//- Muraviev Sergey 2023.12.08

КонецПроцедуры

