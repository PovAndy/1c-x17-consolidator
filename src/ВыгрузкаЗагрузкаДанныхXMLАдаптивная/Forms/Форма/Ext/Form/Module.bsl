		Возврат PreviewПобедыАдресныхФильтровЛСНаСервере();
	ИначеЕсли ИмяСценария = "fix-pobedy-street-split" Тогда
		Возврат ИсправитьПобедыАдресныеФильтрыЛСНаСервере();
	ИначеЕсли ИмяСценария = "preview-dismissal-bases-36-14" Тогда
