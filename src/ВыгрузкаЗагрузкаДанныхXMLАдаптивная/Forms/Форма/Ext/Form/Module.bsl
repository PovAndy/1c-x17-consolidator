#Область Адапт_ЦелостностьТиС

&НаКлиентеНаСервереБезКонтекста
Функция Адапт_ФорматДлительности(КоличествоСекунд)

	Попытка
		ВсегоСекунд = Макс(0, Цел(КоличествоСекунд));
	Исключение
		ВсегоСекунд = 0;
	КонецПопытки;

	Дни = Цел(ВсегоСекунд / 86400);
	ОстатокСекунд = ВсегоСекунд - Дни * 86400;
	Часы = Цел(ОстатокСекунд / 3600);
	ОстатокСекунд = ОстатокСекунд - Часы * 3600;
	Минуты = Цел(ОстатокСекунд / 60);
	Секунды = ОстатокСекунд - Минуты * 60;

	ТекстЧасов = Прав("0" + Строка(Часы), 2);
	ТекстМинут = Прав("0" + Строка(Минуты), 2);
	ТекстСекунд = Прав("0" + Строка(Секунды), 2);
	Если Дни > 0 Тогда
		ТекстДней = Строка(Дни);
		Если Дни < 10 Тогда
			ТекстДней = "0" + ТекстДней;
		КонецЕсли;
		Возврат ТекстДней + ":" + ТекстЧасов + ":"
			+ ТекстМинут + ":" + ТекстСекунд;
	КонецЕсли;
	Если Часы > 0 Тогда
		Возврат ТекстЧасов + ":" + ТекстМинут + ":" + ТекстСекунд;
	КонецЕсли;
	Возврат ТекстМинут + ":" + ТекстСекунд;

КонецФункции

&НаКлиенте
Процедура Адапт_ПоказатьРезультатЦелостностиТиС(Результат, ТекстОшибки, Заголовок)

	Если Результат = Неопределено Тогда
		СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		СообщитьПользователю(
			ТекстОшибки + " Получен результат неожиданного типа: " + Строка(ТипЗнч(Результат)));
		Возврат;
	КонецЕсли;

	ТекстОтчета = "";
	КраткийИтог = "";
	Результат.Свойство("ПолныйОтчет", ТекстОтчета);
	Результат.Свойство("КраткийИтог", КраткийИтог);
	Если ТекстОтчета = Неопределено Тогда
		ТекстОтчета = "";
	Иначе
		ТекстОтчета = Строка(ТекстОтчета);
	КонецЕсли;
	Если КраткийИтог = Неопределено Тогда
		КраткийИтог = "";
	Иначе
		КраткийИтог = Строка(КраткийИтог);
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(ТекстОтчета)) Тогда
		ТекстОтчета = КраткийИтог;
	КонецЕсли;
	Если ПустаяСтрока(СокрЛП(ТекстОтчета)) Тогда
		ТекстОтчета = ТекстОшибки;
	КонецЕсли;

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ТекстОтчета);

	ИмяВременногоФайла = "";
	ОшибкаЗаписи = "";
	Попытка
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("md");
		ТекстовыйДокумент.Записать(ИмяВременногоФайла, КодировкаТекста.UTF8);
	Исключение
		ОшибкаЗаписи = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ТекстСообщения = КраткийИтог;
	Если ПустаяСтрока(СокрЛП(ТекстСообщения)) Тогда
		ТекстСообщения = "Отчет сформирован.";
	КонецЕсли;
	Если НЕ ПустаяСтрока(ИмяВременногоФайла) И ПустаяСтрока(ОшибкаЗаписи) Тогда
		ТекстСообщения = ТекстСообщения + Символы.ПС
			+ "Файл отчета: " + ИмяВременногоФайла;
	ИначеЕсли НЕ ПустаяСтрока(ОшибкаЗаписи) Тогда
		ТекстСообщения = ТекстСообщения + Символы.ПС
			+ "Не удалось сохранить файл отчета: " + ОшибкаЗаписи;
	КонецЕсли;

	СообщитьПользователю(ТекстСообщения);
	ПоказатьОповещениеПользователя(Заголовок, , ТекстСообщения);

	ОшибкаОткрытияФайла = "";
	Если НЕ ПустаяСтрока(ИмяВременногоФайла) И ПустаяСтрока(ОшибкаЗаписи) Тогда
		Попытка
			ЗапуститьПриложение(ИмяВременногоФайла);
		Исключение
			ОшибкаОткрытияФайла = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			СообщитьПользователю(
				"Не удалось открыть файл отчета: " + ОшибкаОткрытияФайла
				+ Символы.ПС + ИмяВременногоФайла);
		КонецПопытки;
	КонецЕсли;

	Если НЕ ПустаяСтрока(ОшибкаЗаписи)
		Или НЕ ПустаяСтрока(ОшибкаОткрытияФайла) Тогда
		Попытка
			ТекстовыйДокумент.Показать(Заголовок);
		Исключение
			ОшибкаПоказа = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			СообщитьПользователю("Не удалось открыть отчет внутри 1С: " + ОшибкаПоказа);
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

