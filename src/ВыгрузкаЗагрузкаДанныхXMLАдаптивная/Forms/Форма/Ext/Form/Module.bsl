&НаКлиенте
Процедура Адапт_СвязиКлючейАналитикиРегистрДвиженийНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	ИсключаемыеТипы = Новый Массив;
	ИсключаемыеТипы.Добавить("ЛюбаяСсылка");
	ИсключаемыеТипы.Добавить("ОпределяемыеТипы");
	ИсключаемыеТипы.Добавить("Справочники");
	ИсключаемыеТипы.Добавить("Документы");
	ИсключаемыеТипы.Добавить("ПланыВидовХарактеристик");
	ИсключаемыеТипы.Добавить("ПланыСчетов");
	ИсключаемыеТипы.Добавить("ПланыВидовРасчета");
	ИсключаемыеТипы.Добавить("БизнесПроцессы");
	ИсключаемыеТипы.Добавить("ТочкиМаршрутаБизнесПроцесса");
	ИсключаемыеТипы.Добавить("Задачи");
	ИсключаемыеТипы.Добавить("ПланыОбмена");
	ИсключаемыеТипы.Добавить("РегистрыНакопления");
	ИсключаемыеТипы.Добавить("РегистрыБухгалтерии");
	ИсключаемыеТипы.Добавить("РегистрыРасчета");

	СтандартнаяОбработка = Ложь;

	ТипОбъекта = Элементы.СвязиКлючейАналитики.ТекущиеДанные.РегистрДвижений;

	ДополнительныеПараметры = Новый Структура("Элемент", Элемент);
	ПараметрыОткрытия = Новый Структура("ТипОбъекта, ИсключаемыеТипы", ТипОбъекта, ИсключаемыеТипы);
	ОписаниеОповещения = Новый ОписаниеОповещения("Адапт_СвязиКлючейАналитики_РегистрДвиженийНачалоВыбораЗавершение", ЭтотОбъект, ДополнительныеПараметры);


	Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;

	ИмяФормыВыбораТипа = Адапт_ПолноеИмяФормы("ФормаВыбораТипа");
	ОткрытьФорму(ИмяФормыВыбораТипа, ПараметрыОткрытия, ЭтотОбъект, , , , ОписаниеОповещения, Режим);

КонецПроцедуры

&НаКлиенте
Процедура Адапт_СвязиКлючейАналитики_РегистрДвиженийНачалоВыбораЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт

	Перем Элемент;

	Если РезультатВыполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Элемент = ДополнительныеПараметры.Элемент;

	Элемент.ВыбиратьТип = Ложь;
	Элемент.КартинкаКнопкиВыбора = Новый Картинка;
	Элемент.КнопкаВыбора = Истина;
	Элемент.КнопкаОткрытия = Неопределено;
	Элемент.ОграничениеТипа = Новый ОписаниеТипов("Строка");
	Элемент.РедактированиеТекста = Ложь;
	Элемент.КнопкаВыпадающегоСписка = Неопределено;

	ТекДанные = Элементы.СвязиКлючейАналитики.ТекущиеДанные;
	Если ТипЗнч(РезультатВыполнения.ОписаниеТипов) = Тип("ОписаниеТипов") Тогда
		ТекДанные.РегистрДвижений = РезультатВыполнения.Типы()[0];
	Иначе
		ТекДанные.РегистрДвижений = РезультатВыполнения.Представление;
	КонецЕсли;
	ТекДанные.РегистрДвиженийМетаданныеОк = Истина;

	Элементы.СвязиКлючейАналитики.ЗакончитьРедактированиеСтроки(Ложь);

КонецПроцедуры

