&НаКлиенте
Функция Адапт_СтабилизироватьВидыСубконтоИНULL()

	Результат = Новый Структура(
		"ЕстьПроблемы,БылиИзменения,КраткийИтог,ПолныйОтчет",
		Ложь, Ложь, "", "");
	СтрокиОтчета = Новый Массив;
	СтрокиОтчета.Добавить(Символ(35)
		+ " Стабилизация видов субконто и NULL-ресурсов");
	Стабильно = Ложь;

	Для НомерИтерации = 1 По 3 Цикл
		Состояние("[22.6] Стабилизация " + Строка(НомерИтерации)
			+ "/3: [22.4] виды субконто...");
		ОбновитьИнтерфейс();
		РезультатПВХ =
			Адапт_ВыполнитьЭтапЦелостностиТиСНаСервере("pvh");
		Если РезультатПВХ = Неопределено
			Или ТипЗнч(РезультатПВХ) <> Тип("Структура") Тогда
			Результат.ЕстьПроблемы = Истина;
			Результат.КраткийИтог = "STOP: [22.4] не вернул корректный результат";
			Прервать;
		КонецЕсли;

		ИзмененияПВХ = Ложь;
		РезультатПВХ.Свойство("БылиИзменения", ИзмененияПВХ);
		Результат.БылиИзменения = Результат.БылиИзменения Или ИзмененияПВХ;
		СтрокиОтчета.Добавить("");
		СтрокиОтчета.Добавить(Символ(35) + Символ(35) + " Итерация "
			+ Строка(НомерИтерации) + ": [22.4]");
		СтрокиОтчета.Добавить(РезультатПВХ.ПолныйОтчет);
		Если РезультатПВХ.ЕстьПроблемы Тогда
			Результат.ЕстьПроблемы = Истина;
			Результат.КраткийИтог = "STOP на стабилизации [22.4]: "
				+ РезультатПВХ.КраткийИтог;
			Прервать;
		КонецЕсли;

		Состояние("[22.6] Стабилизация " + Строка(НомерИтерации)
			+ "/3: NULL-ресурсы...");
		ОбновитьИнтерфейс();
		РезультатNULL =
			Адапт_ВыполнитьВосстановлениеNULLРесурсовПоПакетам(Истина);
		Если РезультатNULL = Неопределено
			Или ТипЗнч(РезультатNULL) <> Тип("Структура") Тогда
			Результат.ЕстьПроблемы = Истина;
			Результат.КраткийИтог = "STOP: NULL-этап не вернул корректный результат";
			Прервать;
		КонецЕсли;

		ИзмененияNULL = Ложь;
		РезультатNULL.Свойство("БылиИзменения", ИзмененияNULL);
		Результат.БылиИзменения = Результат.БылиИзменения Или ИзмененияNULL;
		СтрокиОтчета.Добавить("");
		СтрокиОтчета.Добавить(Символ(35) + Символ(35) + " Итерация "
			+ Строка(НомерИтерации) + ": NULL");
		СтрокиОтчета.Добавить(РезультатNULL.ПолныйОтчет);
		Если РезультатNULL.ЕстьПроблемы Тогда
			Результат.ЕстьПроблемы = Истина;
			Результат.КраткийИтог = "STOP на стабилизации NULL: "
				+ РезультатNULL.КраткийИтог;
			Прервать;
		КонецЕсли;

		Если Не ИзмененияПВХ И Не ИзмененияNULL Тогда
			Стабильно = Истина;
			Результат.КраткийИтог = "стабильно на итерации "
				+ Строка(НомерИтерации) + "; изменений ПВХ/NULL нет";
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не Результат.ЕстьПроблемы И Не Стабильно Тогда
		Состояние("[22.6] Read-only контроль после 3 итераций стабилизации...");
		ОбновитьИнтерфейс();
		КонтрольСтабилизации =
			Адапт_ВыполнитьЭтапЦелостностиТиСНаСервере(
				"stabilization_control");
		Если КонтрольСтабилизации = Неопределено
			Или ТипЗнч(КонтрольСтабилизации) <> Тип("Структура") Тогда
			Результат.ЕстьПроблемы = Истина;
			Результат.КраткийИтог =
				"STOP: контроль стабилизации не вернул корректный результат";
		Иначе
			СтрокиОтчета.Добавить("");
			СтрокиОтчета.Добавить(Символ(35) + Символ(35)
				+ " Read-only контроль после 3 итераций");
			СтрокиОтчета.Добавить(КонтрольСтабилизации.ПолныйОтчет);
			Если КонтрольСтабилизации.ЕстьПроблемы Тогда
				Результат.ЕстьПроблемы = Истина;
				Результат.КраткийИтог =
					"STOP: состояние ПВХ/NULL не стабилизировалось: "
					+ КонтрольСтабилизации.КраткийИтог;
			Иначе
				Стабильно = Истина;
				Результат.КраткийИтог =
					"стабильно по read-only контролю после 3 итераций: "
					+ КонтрольСтабилизации.КраткийИтог;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	СтрокиОтчета.Добавить("");
	СтрокиОтчета.Добавить("- Итог: " + Результат.КраткийИтог);
	Результат.ПолныйОтчет = СтрСоединить(СтрокиОтчета, Символы.ПС);
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция Адапт_ВыполнитьАвтоконвейерТиСПоЭтапам()

	Результат = Новый Структура(
		"ЕстьПроблемы,БылиИзменения,КраткийИтог,ПолныйОтчет",
		Ложь, Ложь, "", "");
	СтрокиОтчета = Новый Массив;
	СтрокиОтчета.Добавить(Символ(35) + " [22.6] Поэтапный автоконвейер исправления ТиС");
	СтрокиОтчета.Добавить("");

	Этапы = Новый Массив;
	Этапы.Добавить(Новый Структура("Код,Номер,Название",
		"pipeline_preflight", "0/6", "Preflight: проверка предохранителей"));
	Этапы.Добавить(Новый Структура("Код,Номер,Название",
		"pvh", "1/6", "[22.4] Виды субконто Хозрасчетного"));
	Этапы.Добавить(Новый Структура("Код,Номер,Название",
		"predefined", "2/6", "[22.3] Предопределенные данные"));
	Этапы.Добавить(Новый Структура("Код,Номер,Название",
		"stabilize", "3/6", "Стабилизация [22.4] и NULL"));
	Этапы.Добавить(Новый Структура("Код,Номер,Название",
		"accounting", "4/6", "[22.5] Значения субконто Хозрасчетного"));
	Этапы.Добавить(Новый Структура("Код,Номер,Название",
		"null_normalize", "5/6", "Финальный контроль и нормализация NULL-ресурсов"));
	Этапы.Добавить(Новый Структура("Код,Номер,Название",
		"final", "6/6", "[22.7] Финальный контроль"));

	НачалоКонвейера = ТекущаяДата();
	Для Каждого Этап Из Этапы Цикл
		НачалоЭтапа = ТекущаяДата();
		ТекстСостояния = "[22.6] Этап " + Этап.Номер + ": " + Этап.Название;
		Состояние(ТекстСостояния + ". Пожалуйста, подождите...");
		СообщитьПользователю(ТекстСостояния + "; начало="
			+ Формат(НачалоЭтапа, "ДФ=dd.MM.yyyy HH:mm:ss"));
		ОбновитьИнтерфейс();

		Если Этап.Код = "stabilize" Тогда
			РезультатЭтапа = Адапт_СтабилизироватьВидыСубконтоИНULL();
		ИначеЕсли Этап.Код = "null_normalize" Тогда
			РезультатЭтапа =
				Адапт_ВыполнитьВосстановлениеNULLРесурсовПоПакетам(Истина);
		Иначе
			РезультатЭтапа =
				Адапт_ВыполнитьЭтапЦелостностиТиСНаСервере(Этап.Код);
		КонецЕсли;
		ДлительностьЭтапа = ТекущаяДата() - НачалоЭтапа;
		СообщитьПользователю(ТекстСостояния + "; завершен; длительность="
			+ Адапт_ФорматДлительности(ДлительностьЭтапа));

		СтрокиОтчета.Добавить("");
		СтрокиОтчета.Добавить(Символ(35) + Символ(35) + " Этап " + Этап.Номер + ": " + Этап.Название);
		СтрокиОтчета.Добавить("- Длительность: "
			+ Адапт_ФорматДлительности(ДлительностьЭтапа));

		Если РезультатЭтапа = Неопределено
			Или ТипЗнч(РезультатЭтапа) <> Тип("Структура") Тогда
			Результат.ЕстьПроблемы = Истина;
			Результат.КраткийИтог = "STOP: этап " + Этап.Номер + " не вернул корректный результат";
			СтрокиОтчета.Добавить("- " + Результат.КраткийИтог);
			Прервать;
		КонецЕсли;

		КраткийИтогЭтапа = "";
		ПолныйОтчетЭтапа = "";
		БылиИзмененияЭтапа = Ложь;
		РезультатЭтапа.Свойство("КраткийИтог", КраткийИтогЭтапа);
		РезультатЭтапа.Свойство("ПолныйОтчет", ПолныйОтчетЭтапа);
		РезультатЭтапа.Свойство("БылиИзменения", БылиИзмененияЭтапа);
		Результат.БылиИзменения = Результат.БылиИзменения Или БылиИзмененияЭтапа;
		СтрокиОтчета.Добавить("- Итог: " + КраткийИтогЭтапа);
		Если Не ПустаяСтрока(СокрЛП(ПолныйОтчетЭтапа)) Тогда
			СтрокиОтчета.Добавить(ПолныйОтчетЭтапа);
		КонецЕсли;

		Если РезультатЭтапа.ЕстьПроблемы Тогда
			Результат.ЕстьПроблемы = Истина;
			Результат.КраткийИтог = "STOP на этапе " + Этап.Номер + ": " + КраткийИтогЭтапа;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	ОбщаяДлительность = ТекущаяДата() - НачалоКонвейера;
	Если Не Результат.ЕстьПроблемы Тогда
		Результат.КраткийИтог = "Конвейер завершен, [22.7] чистый; требуется повторный ТиС";
	КонецЕсли;
	СтрокиОтчета.Добавить("");
	СтрокиОтчета.Добавить("- Общая длительность: "
		+ Адапт_ФорматДлительности(ОбщаяДлительность));
	СтрокиОтчета.Добавить("- Итог: " + Результат.КраткийИтог);
	Результат.ПолныйОтчет = СтрСоединить(СтрокиОтчета, Символы.ПС);
	Состояние("[22.6] " + Результат.КраткийИтог + "; "
		+ Адапт_ФорматДлительности(ОбщаяДлительность));
	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура Адапт_ИзменениеЦелостностиТиСЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ОчиститьСообщения();
	Если Адапт_ЗапуститьДолгуюОперациюВФоновомРежиме(
		"Адапт_ВыполнитьЭтапЦелостностиТиСНаСервере",
		ДополнительныеПараметры.Этап) Тогда
		Возврат;
	КонецЕсли;
	Если ДополнительныеПараметры.Этап = "pipeline" Тогда
		Результат = Адапт_ВыполнитьАвтоконвейерТиСПоЭтапам();
	ИначеЕсли ДополнительныеПараметры.Этап = "null_fix" Тогда
		Результат = Адапт_ВыполнитьВосстановлениеNULLРесурсовПоПакетам();
	Иначе
		Состояние("Выполняется контролируемое исправление ТиС. Пожалуйста, подождите...");
		Результат = Адапт_ВыполнитьЭтапЦелостностиТиСНаСервере(ДополнительныеПараметры.Этап);
	КонецЕсли;
	Адапт_ПоказатьРезультатЦелостностиТиС(
		Результат,
		"Не удалось получить результат исправления ТиС.",
		ДополнительныеПараметры.Заголовок);

КонецПроцедуры

&НаКлиенте
Функция Адапт_ВыполнитьВосстановлениеNULLРесурсовПоПакетам(
	ВыполнитьСтрогийПилот = Ложь)

	Результат = Новый Структура(
		"ЕстьПроблемы,БылиИзменения,КраткийИтог,ПолныйОтчет",
		Ложь, Ложь, "", "");
	СтрокиОтчета = Новый Массив;
	СтрокиОтчета.Добавить(Символ(35) + " [22.10] Автоматическое восстановление NULL-ресурсов");
	СтрокиОтчета.Добавить("");
	НачалоОперации = ТекущаяДата();
	НомерПакета = 0;
	ВсегоРегистраторов = 0;
	ВсегоЯчеек = 0;
	ВсегоПодгрупп = 0;
	ИсходноРегистраторов = 0;
	ИсходноЯчеек = 0;
	ИсходноДвижений = 0;
	Завершено = Ложь;

	Состояние("[22.10] Глобальный preflight NULL-ресурсов...");
	ОбновитьИнтерфейс();
	ПредварительныйКонтроль =
		Адапт_ВыполнитьЭтапЦелостностиТиСНаСервере("null_fix_preflight");
	Если ПредварительныйКонтроль = Неопределено
		Или ТипЗнч(ПредварительныйКонтроль) <> Тип("Структура") Тогда
		Результат.ЕстьПроблемы = Истина;
		Результат.КраткийИтог = "STOP: глобальный preflight не вернул корректный результат";
	ИначеЕсли ПредварительныйКонтроль.ЕстьПроблемы Тогда
		Результат.ЕстьПроблемы = Истина;
		Результат.КраткийИтог = "STOP: " + ПредварительныйКонтроль.КраткийИтог;
		СтрокиОтчета.Добавить(ПредварительныйКонтроль.ПолныйОтчет);
	Иначе
		ЕстьКоличествоРегистраторов = ПредварительныйКонтроль.Свойство(
			"КоличествоРегистраторов", ИсходноРегистраторов);
		ЕстьКоличествоКандидатов = ПредварительныйКонтроль.Свойство(
			"КоличествоКандидатов", ИсходноЯчеек);
		ЕстьКоличествоДвижений = ПредварительныйКонтроль.Свойство(
			"ВсегоДвижений", ИсходноДвижений);
		Если Не ЕстьКоличествоРегистраторов Или Не ЕстьКоличествоКандидатов
			Или Не ЕстьКоличествоДвижений Тогда
			Результат.ЕстьПроблемы = Истина;
			Результат.КраткийИтог = "STOP: глобальный preflight нарушил контракт результата";
		Иначе
			СтрокиОтчета.Добавить("- Глобальный preflight: "
				+ ПредварительныйКонтроль.КраткийИтог);
			Завершено = ИсходноРегистраторов = 0;
		КонецЕсли;
	КонецЕсли;

	Если Не Результат.ЕстьПроблемы И Не Завершено
		И ВыполнитьСтрогийПилот Тогда
		Состояние("[22.10] Строгий пилот одного регистратора...");
		ОбновитьИнтерфейс();
		РезультатПилота =
			Адапт_ВыполнитьЭтапЦелостностиТиСНаСервере("null_pilot");
		Если РезультатПилота = Неопределено
			Или ТипЗнч(РезультатПилота) <> Тип("Структура") Тогда
			Результат.ЕстьПроблемы = Истина;
			Результат.КраткийИтог = "STOP: строгий пилот не вернул корректный результат";
		ИначеЕсли РезультатПилота.ЕстьПроблемы Тогда
			Результат.ЕстьПроблемы = Истина;
			Результат.КраткийИтог = "STOP: строгий пилот: "
				+ РезультатПилота.КраткийИтог;
			СтрокиОтчета.Добавить(РезультатПилота.ПолныйОтчет);
		Иначе
			ОбработаноПилотом = 0;
			ИсправленоПилотом = 0;
			ПилотЗавершил = Ложь;
			РезультатПилота.Свойство(
				"ОбработаноРегистраторов", ОбработаноПилотом);
			РезультатПилота.Свойство("ИсправленоЯчеек", ИсправленоПилотом);
			РезультатПилота.Свойство("Завершено", ПилотЗавершил);
			ВсегоРегистраторов = ВсегоРегистраторов + ОбработаноПилотом;
			ВсегоЯчеек = ВсегоЯчеек + ИсправленоПилотом;
			Результат.БылиИзменения = Результат.БылиИзменения
				Или ОбработаноПилотом > 0;
			Завершено = ПилотЗавершил;
			СтрокиОтчета.Добавить("- Строгий пилот: "
				+ РезультатПилота.КраткийИтог);
		КонецЕсли;
	КонецЕсли;

	Пока Не Результат.ЕстьПроблемы И Не Завершено И НомерПакета < 100 Цикл
		НомерПакета = НомерПакета + 1;
		Состояние("[22.10] Пакет " + Строка(НомерПакета)
			+ ": до 5000 регистраторов, транзакции по 500. Пожалуйста, подождите...");
		ОбновитьИнтерфейс();
		РезультатПакета = Адапт_ВыполнитьЭтапЦелостностиТиСНаСервере("null_fix_package");
		Если РезультатПакета = Неопределено
			Или ТипЗнч(РезультатПакета) <> Тип("Структура") Тогда
			Результат.ЕстьПроблемы = Истина;
			Результат.КраткийИтог = "STOP: пакет не вернул корректный результат";
			Прервать;
		КонецЕсли;

		ОбработаноРегистраторов = 0;
		ИсправленоЯчеек = 0;
		ОбработаноПодгрупп = 0;
		Завершено = Ложь;
		РезультатПакета.Свойство("ОбработаноРегистраторов", ОбработаноРегистраторов);
		РезультатПакета.Свойство("ИсправленоЯчеек", ИсправленоЯчеек);
		РезультатПакета.Свойство("ОбработаноПодгрупп", ОбработаноПодгрупп);
		РезультатПакета.Свойство("Завершено", Завершено);
		ВсегоРегистраторов = ВсегоРегистраторов + ОбработаноРегистраторов;
		ВсегоЯчеек = ВсегоЯчеек + ИсправленоЯчеек;
		ВсегоПодгрупп = ВсегоПодгрупп + ОбработаноПодгрупп;
		ОсталосьРегистраторов = Макс(0, ИсходноРегистраторов - ВсегоРегистраторов);
		Результат.БылиИзменения = Результат.БылиИзменения
			Или ОбработаноРегистраторов > 0;
		СтрокиОтчета.Добавить("- Пакет " + Строка(НомерПакета)
			+ ": " + РезультатПакета.КраткийИтог);
		СообщитьПользователю("[22.10] Пакет " + Строка(НомерПакета)
			+ " завершен; всего регистраторов=" + Строка(ВсегоРегистраторов)
			+ "; осталось=" + Строка(ОсталосьРегистраторов));

		Если РезультатПакета.ЕстьПроблемы Тогда
			Результат.ЕстьПроблемы = Истина;
			Результат.КраткийИтог = "STOP на пакете " + Строка(НомерПакета)
				+ ": " + РезультатПакета.КраткийИтог;
			СтрокиОтчета.Добавить(РезультатПакета.ПолныйОтчет);
			Прервать;
		КонецЕсли;
		Если Завершено Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если НомерПакета >= 100 И Не Завершено И Не Результат.ЕстьПроблемы Тогда
		Результат.ЕстьПроблемы = Истина;
		Результат.КраткийИтог = "STOP: превышен предохранительный лимит 100 пакетов";
	КонецЕсли;
	Если Не Результат.ЕстьПроблемы Тогда
		Контроль = Адапт_ВыполнитьЭтапЦелостностиТиСНаСервере("null_control");
		Если Контроль = Неопределено
			Или ТипЗнч(Контроль) <> Тип("Структура") Тогда
			Результат.ЕстьПроблемы = Истина;
			Результат.КраткийИтог = "STOP: финальный контроль не вернул корректный результат";
		ИначеЕсли Контроль.ЕстьПроблемы Тогда
			Результат.ЕстьПроблемы = Истина;
			Результат.КраткийИтог = "STOP: финальный контроль NULL-ресурсов не пройден";
			СтрокиОтчета.Добавить(Контроль.ПолныйОтчет);
		Иначе
			ФинальноЯчеек = -1;
			ФинальноРегистраторов = -1;
			ФинальноБлокеров = -1;
			ФинальноДвижений = -1;
			ЕстьФинальноЯчеек = Контроль.Свойство(
				"КоличествоКандидатов", ФинальноЯчеек);
			ЕстьФинальноРегистраторов = Контроль.Свойство(
				"КоличествоРегистраторов", ФинальноРегистраторов);
			ЕстьФинальноБлокеров = Контроль.Свойство(
				"КоличествоБлокеров", ФинальноБлокеров);
			ЕстьФинальноДвижений = Контроль.Свойство(
				"ВсегоДвижений", ФинальноДвижений);
			Если Не ЕстьФинальноЯчеек Или Не ЕстьФинальноРегистраторов
				Или Не ЕстьФинальноБлокеров Или Не ЕстьФинальноДвижений Тогда
				Результат.ЕстьПроблемы = Истина;
				Результат.КраткийИтог = "STOP: финальный контроль нарушил контракт результата";
			ИначеЕсли ФинальноЯчеек <> 0 Или ФинальноРегистраторов <> 0
				Или ФинальноБлокеров <> 0 Тогда
				Результат.ЕстьПроблемы = Истина;
				Результат.КраткийИтог = "STOP: финальный контроль="
					+ Строка(ФинальноЯчеек) + "/"
					+ Строка(ФинальноРегистраторов) + "/"
					+ Строка(ФинальноБлокеров);
			ИначеЕсли ФинальноДвижений <> ИсходноДвижений Тогда
				Результат.ЕстьПроблемы = Истина;
				Результат.КраткийИтог = "STOP: изменилось число движений: до="
					+ Строка(ИсходноДвижений) + "; после=" + Строка(ФинальноДвижений);
			Иначе
				СтрокиОтчета.Добавить(Контроль.ПолныйОтчет);
				Результат.КраткийИтог = "восстановлено подгрупп=" + Строка(ВсегоПодгрупп)
					+ "; регистраторов="
					+ Строка(ВсегоРегистраторов) + "; ячеек=" + Строка(ВсегоЯчеек)
					+ "; контроль=0/0/0; движений до=после="
					+ Строка(ФинальноДвижений);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Длительность = ТекущаяДата() - НачалоОперации;
	СтрокиОтчета.Добавить("");
	СтрокиОтчета.Добавить("- Общая длительность: "
		+ Адапт_ФорматДлительности(Длительность));
	СтрокиОтчета.Добавить("- Итог: " + Результат.КраткийИтог);
	Результат.ПолныйОтчет = СтрСоединить(СтрокиОтчета, Символы.ПС);
	Состояние("[22.10] " + Результат.КраткийИтог);
	Возврат Результат;

КонецФункции

&НаСервере
Функция Адапт_ВыполнитьЭтапЦелостностиТиСНаСервере(Этап)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

	Если Этап = "diagnostic" Тогда
		Возврат ОбработкаОбъект.Адапт_ДиагностикаЦелостностиТиС();
	ИначеЕсли Этап = "preview" Тогда
		Возврат ОбработкаОбъект.Адапт_PreviewИсправленияЦелостностиТиС();
	ИначеЕсли Этап = "predefined" Тогда
		Возврат ОбработкаОбъект.Адапт_ИсправитьПредопределенныеТиС();
	ИначеЕсли Этап = "pvh" Тогда
		Возврат ОбработкаОбъект.Адапт_ВосстановитьУдаленныеСсылкиПВХТиС(
			АдаптПутьККартеВосстановленияПрочихХарактеристик);
	ИначеЕсли Этап = "accounting" Тогда
		Возврат ОбработкаОбъект.Адапт_ПересобратьХозрасчетныйТиС();
	ИначеЕсли Этап = "pipeline_preflight" Тогда
		Возврат ОбработкаОбъект.Адапт_PreflightАвтоконвейераТиС();
	ИначеЕсли Этап = "stabilization_control" Тогда
		Возврат ОбработкаОбъект.Адапт_КонтрольСтабилизацииПВХИНULLТиС();
	ИначеЕсли Этап = "pipeline" Тогда
		Возврат ОбработкаОбъект.Адапт_АвтоконвейерИсправленияТиС(
			АдаптПутьККартеВосстановленияПрочихХарактеристик);
	ИначеЕсли Этап = "final" Тогда
		Возврат ОбработкаОбъект.Адапт_ФинальныйКонтрольТиС();
	ИначеЕсли Этап = "null_preview" Тогда
		Возврат ОбработкаОбъект.Адапт_PreviewВосстановленияNULLРесурсовТиС();
	ИначеЕсли Этап = "null_pilot" Тогда
		Возврат ОбработкаОбъект.Адапт_ПилотВосстановленияNULLРесурсовТиС();
	ИначеЕсли Этап = "null_fix_preflight" Тогда
		Возврат ОбработкаОбъект.Адапт_PreflightИсправленияNULLРесурсовТиС();
	ИначеЕсли Этап = "null_fix_package" Тогда
		Возврат ОбработкаОбъект.Адапт_ИсправитьNULLРесурсыХозрасчетногоТиСПакет(5000);
	ИначеЕсли Этап = "null_control" Тогда
		Возврат ОбработкаОбъект.Адапт_КонтрольВосстановленияNULLРесурсовТиС();
	ИначеЕсли Этап = "tis_residuals" Тогда
		Возврат ОбработкаОбъект.Адапт_ДиагностикаОстатковТиС();
	ИначеЕсли Этап = "tis_residual_donor_preview" Тогда
		Возврат ОбработкаОбъект.Адапт_PreviewДонорнойКартыОстатковТиС();
	ИначеЕсли Этап = "tis_residual_ready_preview" Тогда
		Возврат ОбработкаОбъект.Адапт_PreviewИсправленияREADYОстатковТиС();
	ИначеЕсли Этап = "tis_residual_readonly_cycle" Тогда
		Возврат ОбработкаОбъект.Адапт_КомплексныйReadOnlyКонтрольОстатковТиС();
	ИначеЕсли Этап = "fresh_copy_readonly_audit" Тогда
		Возврат ОбработкаОбъект.Адапт_ПолныйReadOnlyАудитСвежейКопии();
	ИначеЕсли Этап = "fresh_copy_core_repair" Тогда
		Возврат ОбработкаОбъект.Адапт_ПервыйМассовыйЭтапВосстановленияСвежейКопии(
			АдаптПутьККартеВосстановленияПрочихХарактеристик);
	ИначеЕсли Этап = "fresh_copy_residual_repair" Тогда
		Возврат ОбработкаОбъект.Адапт_ЗавершитьОстаточныеСсылкиСвежейКопии();
	ИначеЕсли Этап = "fresh_copy_catalog_ready_fix" Тогда
		Возврат ОбработкаОбъект.Адапт_ИсправитьREADYКодыСвежейКопии();
	ИначеЕсли Этап = "tis_residual_ready_fix" Тогда
		Возврат ОбработкаОбъект.Адапт_ИсправитьREADYОстаткиТиС();
	ИначеЕсли Этап = "tis_residual_second_preview" Тогда
		Возврат ОбработкаОбъект.Адапт_PreviewВторойПартииОстатковТиС();
	ИначеЕсли Этап = "tis_residual_second_fix" Тогда
		Возврат ОбработкаОбъект.Адапт_ИсправитьВторуюПартиюОстатковТиС();
	ИначеЕсли Этап = "tis_residual_system_preview" Тогда
		Возврат ОбработкаОбъект.Адапт_PreviewСистемногоХвостаТиС();
	ИначеЕсли Этап = "tis_residual_system_fix" Тогда
		Возврат ОбработкаОбъект.Адапт_ИсправитьСистемныйХвостТиС();
	КонецЕсли;

	Возврат Неопределено;

