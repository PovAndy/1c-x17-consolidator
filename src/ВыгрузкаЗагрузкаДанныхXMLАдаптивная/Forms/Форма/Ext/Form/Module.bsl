	ПараметрыЗапуска = Новый Структура;
	ПараметрыЗапуска.Вставить("ИмяФайла", "");
	СтруктураФоновогоЗадания = Адапт_ВыполнитьФоновоеЗаданиеНаСервере(НаименованиеЗадания, ИмяМетода, ПараметрыЗапуска, "", АдресВХОбработки);

