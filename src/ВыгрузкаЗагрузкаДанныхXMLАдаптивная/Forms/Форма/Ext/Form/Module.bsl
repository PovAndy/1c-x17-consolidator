	Возврат Неопределено;

КонецФункции

&НаКлиенте
Процедура Адапт_ВыполнитьАвтозапуск() Экспорт

	ПутьКСтатусу = "";
	ПутьКОтчету = "";
	ЗакрытьПосле = Истина;
	Действие = "";
	БылаОшибка = Ложь;
	ТекстОшибки = "";
	РезультатСценария = Неопределено;
	ПутьКФайлуЗадания = "";

	Попытка
		ПутьКФайлуЗадания = Адапт_ПутьКФайлуАвтозапускаПоУмолчанию();
		ЗаданиеАвтозапуска = Адапт_ПрочитатьJSONИзФайла(ПутьКФайлуЗадания);
		Если ЗаданиеАвтозапуска = Неопределено Тогда
			Возврат;
		КонецЕсли;

		ПутьКСтатусу = СокрЛП(Строка(Адапт_ПолучитьЗначениеИзJSONОбъекта(ЗаданиеАвтозапуска, "status_path", "")));
		ПутьКОтчету = СокрЛП(Строка(Адапт_ПолучитьЗначениеИзJSONОбъекта(ЗаданиеАвтозапуска, "report_path", "")));
		Действие = СокрЛП(Строка(Адапт_ПолучитьЗначениеИзJSONОбъекта(ЗаданиеАвтозапуска, "action", "")));
		ПутьККартеИзЗадания = СокрЛП(Строка(Адапт_ПолучитьЗначениеИзJSONОбъекта(ЗаданиеАвтозапуска, "restore_map_path", "")));
		Если Не ПустаяСтрока(ПутьККартеИзЗадания) Тогда
			АдаптПутьККартеВосстановленияПрочихХарактеристик = ПутьККартеИзЗадания;
		КонецЕсли;
		ЗакрытьПосле = Адапт_ПолучитьЗначениеИзJSONОбъекта(ЗаданиеАвтозапуска, "close_on_finish", Истина);

		Адапт_ЗаписатьСтатусАвтозапуска(ПутьКСтатусу, Действие, "started", "Автозапуск начат.", ПутьКОтчету, Ложь);

		Если ПустаяСтрока(Действие) Тогда
			БылаОшибка = Истина;
			ТекстОшибки = "В задании автозапуска не указано поле action.";
		Иначе
			Попытка
				РезультатСценария = Адапт_ВыполнитьСценарийАвтозапускаПоИмени(Действие);
				Если РезультатСценария = Неопределено Тогда
					БылаОшибка = Истина;
					ТекстОшибки = "Неизвестный сценарий автозапуска: " + Действие;
				КонецЕсли;
			Исключение
				БылаОшибка = Истина;
				ТекстОшибки = ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;

		Если Не БылаОшибка Тогда
			Если ПустаяСтрока(ПутьКОтчету) Тогда
				ПутьКОтчету = ПолучитьИмяВременногоФайла("md");
			КонецЕсли;
			Адапт_ЗаписатьТекстВФайл(ПутьКОтчету, РезультатСценария.ПолныйОтчет);
		КонецЕсли;

		Адапт_ЗаписатьСтатусАвтозапуска(ПутьКСтатусу, Действие, ?(БылаОшибка, "error", "ok"), ?(БылаОшибка, ТекстОшибки, РезультатСценария.КраткийИтог), ПутьКОтчету, Не БылаОшибка);

		Адапт_УдалитьФайлБезОшибок(ПутьКФайлуЗадания);

		Если ЗакрытьПосле Тогда
			Закрыть();
		КонецЕсли;
	Исключение
		Адапт_ЗаписатьСтатусАвтозапуска(ПутьКСтатусу, Действие, "error", ОписаниеОшибки(), ПутьКОтчету, Ложь);
	КонецПопытки;

КонецПроцедуры

