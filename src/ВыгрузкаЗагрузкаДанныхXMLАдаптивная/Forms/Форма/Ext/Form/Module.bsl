	Возврат Неопределено;

КонецФункции

&НаСервере
Функция Адапт_ПопробоватьВыполнитьАвтозапускНаСервере()

	ПутьКФайлуЗадания = Адапт_ПутьКФайлуАвтозапускаПоУмолчаниюНаСервере();
	ЗаданиеАвтозапуска = Адапт_ПрочитатьJSONИзФайлаНаСервере(ПутьКФайлуЗадания);
	Если ЗаданиеАвтозапуска = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ПутьКСтатусу = "";
	ПутьКОтчету = "";
	Действие = "";
	БылаОшибка = Ложь;
	ТекстОшибки = "";
	РезультатСценария = Неопределено;

	ПутьКСтатусу = СокрЛП(Строка(Адапт_ПолучитьЗначениеИзJSONОбъектаНаСервере(ЗаданиеАвтозапуска, "status_path", "")));
	ПутьКОтчету = СокрЛП(Строка(Адапт_ПолучитьЗначениеИзJSONОбъектаНаСервере(ЗаданиеАвтозапуска, "report_path", "")));
	Действие = СокрЛП(Строка(Адапт_ПолучитьЗначениеИзJSONОбъектаНаСервере(ЗаданиеАвтозапуска, "action", "")));
	ПутьККартеИзЗадания = СокрЛП(Строка(Адапт_ПолучитьЗначениеИзJSONОбъектаНаСервере(ЗаданиеАвтозапуска, "restore_map_path", "")));
	Если Не ПустаяСтрока(ПутьККартеИзЗадания) Тогда
		АдаптПутьККартеВосстановленияПрочихХарактеристик = ПутьККартеИзЗадания;
	КонецЕсли;

	Если ПустаяСтрока(Действие) Тогда
		БылаОшибка = Истина;
		ТекстОшибки = "В задании автозапуска не указано поле action.";
	Иначе
		Попытка
			РезультатСценария = Адапт_ВыполнитьСценарийАвтозапускаПоИмениНаСервере(Действие, ЗаданиеАвтозапуска);
			Если РезультатСценария = Неопределено Тогда
				БылаОшибка = Истина;
				ТекстОшибки = "Неизвестный сценарий автозапуска: " + Действие;
			КонецЕсли;
		Исключение
			БылаОшибка = Истина;
			ТекстОшибки = ОписаниеОшибки();
		КонецПопытки;
	КонецЕсли;

	Если Не БылаОшибка Тогда
		Если ПустаяСтрока(ПутьКОтчету) Тогда
			ПутьКОтчету = КаталогВременныхФайлов() + "epf_autorun_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss") + ".md";
		КонецЕсли;
		Адапт_ЗаписатьТекстВФайлНаСервере(ПутьКОтчету, РезультатСценария.ПолныйОтчет);
	КонецЕсли;

	Если Не ПустаяСтрока(ПутьКСтатусу) Тогда
		СтатусJSON = Новый Структура;
		СтатусJSON.Вставить("success", Не БылаОшибка);
		СтатусJSON.Вставить("action", Действие);
		СтатусJSON.Вставить("report_path", ПутьКОтчету);
		СтатусJSON.Вставить("status", ?(БылаОшибка, "error", "ok"));
		СтатусJSON.Вставить("summary", ?(БылаОшибка, ТекстОшибки, РезультатСценария.КраткийИтог));
		СтатусJSON.Вставить("version", Адапт_ПолучитьЗаголовокОбработкиНаСервере());
		СтатусJSON.Вставить("timestamp", Формат(ТекущаяДата(), "ДЛФ=DT"));
		Адапт_ЗаписатьJSONВФайлНаСервере(ПутьКСтатусу, СтатусJSON);
	КонецЕсли;

	Адапт_УдалитьФайлБезОшибокНаСервере(ПутьКФайлуЗадания);
	Возврат Истина;

КонецФункции

&НаКлиенте
Функция Адапт_ПрочитатьJSONИзФайла(ПутьКФайлу)

	Если ПустаяСтрока(СокрЛП(ПутьКФайлу)) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ТекстовыйФайл = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
		СтрокаJSON = ТекстовыйФайл.Прочитать();
		ТекстовыйФайл.Закрыть();

		Если ПустаяСтрока(СокрЛП(СтрокаJSON)) Тогда
			Возврат Неопределено;
		КонецЕсли;

		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
		ДанныеJSON = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		Возврат ДанныеJSON;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

&НаКлиенте
Функция Адапт_ПолучитьЗначениеИзJSONОбъекта(ДанныеJSON, ИмяПоля, ЗначениеПоУмолчанию = "")

	Если ДанныеJSON = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Попытка
		Если ТипЗнч(ДанныеJSON) = Тип("Структура") Или ТипЗнч(ДанныеJSON) = Тип("ФиксированнаяСтруктура") Тогда
			Если ДанныеJSON.Свойство(ИмяПоля) Тогда
				Возврат ДанныеJSON[ИмяПоля];
			КонецЕсли;
		ИначеЕсли ТипЗнч(ДанныеJSON) = Тип("Соответствие") Или ТипЗнч(ДанныеJSON) = Тип("ФиксированноеСоответствие") Тогда
			Если ДанныеJSON.СодержитКлюч(ИмяПоля) Тогда
				Возврат ДанныеJSON[ИмяПоля];
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

&НаКлиенте
Процедура Адапт_ЗаписатьСтатусАвтозапуска(ПутьКСтатусу, Действие, Статус, КраткоеСообщение, ПутьКОтчету = "", ЭтоУспех = Ложь)

	Если ПустаяСтрока(СокрЛП(ПутьКСтатусу)) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		СтатусJSON = Новый Структура;
		СтатусJSON.Вставить("success", ЭтоУспех);
		СтатусJSON.Вставить("action", Действие);
		СтатусJSON.Вставить("report_path", ПутьКОтчету);
		СтатусJSON.Вставить("status", Статус);
		СтатусJSON.Вставить("summary", КраткоеСообщение);
		СтатусJSON.Вставить("version", Заголовок);
		СтатусJSON.Вставить("timestamp", Формат(ТекущаяДата(), "ДЛФ=DT"));
		Адапт_ЗаписатьJSONВФайл(ПутьКСтатусу, СтатусJSON);
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура Адапт_ЗаписатьJSONВФайл(ПутьКФайлу, ДанныеJSON)

	Если ПустаяСтрока(СокрЛП(ПутьКФайлу)) Тогда
		Возврат;
	КонецЕсли;

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеJSON);
		СтрокаJSON = ЗаписьJSON.Закрыть();

	ТекстовыйФайл = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	ТекстовыйФайл.Записать(СтрокаJSON);
	ТекстовыйФайл.Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура Адапт_ЗаписатьТекстВФайл(ПутьКФайлу, Текст)

	Если ПустаяСтрока(СокрЛП(ПутьКФайлу)) Тогда
		Возврат;
	КонецЕсли;

	ТекстовыйФайл = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	ТекстовыйФайл.Записать(Текст);
	ТекстовыйФайл.Закрыть();

