#Область ОбработчикиСобытийЭлементовТаблицыФормыДополнительныеОбъектыДляВыгрузки

&НаКлиенте
Процедура ДополнительныеОбъектыДляВыгрузкиПриИзменении(Элемент)

	Если Элемент.ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(Элемент.ТекущиеДанные.Объект) Тогда

		Элемент.ТекущиеДанные.ИмяОбъектаДляЗапроса = ИмяОбъектаПоТипуДляЗапроса(Элемент.ТекущиеДанные.Объект);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеОбъектыДляВыгрузкиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)

	Отказ = Истина;

	Если Элемент.ТекущаяСтрока <> Неопределено Тогда
		ОписаниеТипа = Элемент.ТекущийЭлемент.ОграничениеТипа;
	Иначе
		ОписаниеТипа = Новый ОписаниеТипов;
	КонецЕсли;
	Элемент.ТекущийЭлемент.ОграничениеТипа = Новый ОписаниеТипов;

	НовСтрока = Объект.ДополнительныеОбъектыДляВыгрузки.Добавить();
	Элементы.ДополнительныеОбъектыДляВыгрузки.ТекущаяСтрока = НовСтрока.ПолучитьИдентификатор();

	Если ЗначениеЗаполнено(ТипОбъектовДляВыгрузки) Тогда
		СтруктураТипа = Новый Структура();
		СтруктураТипа.Вставить("ОписаниеТипов", ТипОбъектовДляВыгрузки);
		СтруктураТипа.Вставить("Представление", ТипОбъектовДляВыгрузкиСтрокой);
		//Элемент.ПодсказкаВвода = СтруктураОписанияТипа.Представление;
		Адапт_ДопОбъектыУстановитьТипОбъекта(СтруктураТипа);
		ПодключитьОбработчикОжидания("Адапт_ДопОбъектыОткрытьФормуВыбора", 0.3, Истина);
	Иначе
		Адапт_ДопОбъектыОбъектВыборТипа(ОписаниеТипа);
	КонецЕсли;
	ТекущийЭлемент = Элемент;

КонецПроцедуры

&НаКлиенте
Процедура Адапт_ДопОбъектыОбъектВыборТипа(ОписаниеТипа)

	ИсключаемыеТипы = Новый Массив;
	ИсключаемыеТипы.Добавить("РегистрыСведений");
	ИсключаемыеТипы.Добавить("РегистрыНакопления");
	ИсключаемыеТипы.Добавить("РегистрыБухгалтерии");
	ИсключаемыеТипы.Добавить("РегистрыРасчета");
	ИсключаемыеТипы.Добавить("ЛюбаяСсылка");

	ПараметрыОткрытия = Новый Структура("ТипОбъекта, Составной, ИсключаемыеТипы", ОписаниеТипа, Ложь, ИсключаемыеТипы);
	ОписаниеОповещения = Новый ОписаниеОповещения("Адапт_ДопОбъектыОбъектВыборТипаЗавершение", ЭтотОбъект);


	Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;

	ИмяФормыВыборТипа = Адапт_ПолноеИмяФормы("ФормаВыбораТипа");
	ОткрытьФорму(ИмяФормыВыборТипа, ПараметрыОткрытия, ЭтотОбъект, , , , ОписаниеОповещения, Режим);

КонецПроцедуры

&НаКлиенте
Процедура Адапт_ДопОбъектыОбъектВыборТипаЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт

	Если РезультатВыполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Адапт_ДопОбъектыУстановитьТипОбъекта(РезультатВыполнения);

	ПодключитьОбработчикОжидания("Адапт_ДопОбъектыОткрытьФормуВыбора", 0.3, Истина);

КонецПроцедуры

&НаКлиенте
Процедура Адапт_ДопОбъектыУстановитьТипОбъекта(СтруктураОписанияТипа)

	Элемент = Элементы.ДополнительныеОбъектыДляВыгрузкиОбъект;

	Элемент.КнопкаВыбора = Истина;
	Элемент.КнопкаВыпадающегоСписка = Ложь;
	Элемент.КнопкаСоздания = Ложь;
	Элемент.ВыбиратьТип = Ложь;
	Элемент.ОграничениеТипа = СтруктураОписанияТипа.ОписаниеТипов;
	Элемент.ПодсказкаВвода = СтруктураОписанияТипа.Представление;

	ТекДанные = Элементы.ДополнительныеОбъектыДляВыгрузки.ТекущиеДанные;
	ТекДанные.ТипОбъекта = "";

КонецПроцедуры

&НаКлиенте
Процедура Адапт_ТипОбъектовДляВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ИсключаемыеТипы = Новый Массив;
	ИсключаемыеТипы.Добавить("РегистрыСведений");
	ИсключаемыеТипы.Добавить("РегистрыНакопления");
	ИсключаемыеТипы.Добавить("РегистрыБухгалтерии");
	ИсключаемыеТипы.Добавить("РегистрыРасчета");
	ИсключаемыеТипы.Добавить("ЛюбаяСсылка");
	ИсключаемыеТипы.Добавить("ОпределяемыеТипы");


	ПараметрыОткрытия = Новый Структура("ТипОбъекта, Составной, ИсключаемыеТипы", ТипОбъектовДляВыгрузки, Ложь, ИсключаемыеТипы);
	ОписаниеОповещения = Новый ОписаниеОповещения("Адапт_ДопОбъектыВыборАвтоТипаЗавершение", ЭтотОбъект);


	Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;

	ИмяФормыВыборТипа = Адапт_ПолноеИмяФормы("ФормаВыбораТипа");
	ОткрытьФорму(ИмяФормыВыборТипа, ПараметрыОткрытия, ЭтотОбъект, , , , ОписаниеОповещения, Режим);

КонецПроцедуры

&НаКлиенте
Процедура Адапт_ДопОбъектыВыборАвтоТипаЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт

	Если РезультатВыполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТипОбъектовДляВыгрузки = РезультатВыполнения.ОписаниеТипов;
	ТипОбъектовДляВыгрузкиСтрокой = Адапт_СтроковоеПредставлениеТипа(РезультатВыполнения.ОписаниеТипов);
	ТекущийЭлемент = Элементы.ДополнительныеОбъектыДляВыгрузки;

