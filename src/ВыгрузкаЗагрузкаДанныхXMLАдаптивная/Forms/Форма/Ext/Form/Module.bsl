		Возврат PreviewОснованийРасчетаИПараметровУслугНаСервере();
	ИначеЕсли ИмяСценария = "fix-service-basis" Тогда
		Возврат ИсправитьОснованияРасчетаИПараметрыУслугНаСервере();
	ИначеЕсли ИмяСценария = "diagnostics-service-tariffs" Или ИмяСценария = "diag-service-tariffs" Тогда
