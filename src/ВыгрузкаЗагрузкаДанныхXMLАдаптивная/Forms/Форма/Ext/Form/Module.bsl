&НаКлиенте
Процедура Адапт_ВыполнитьНовыеСчетчикиВФоновомРежиме(Режим)

	НаименованиеЗадания = "[7] Новые счетчики: " + Режим;
	ИмяМетода = "Адапт_ВыполнитьСценарийНовыхСчетчиковВФоне";
	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайлаОбработки);
	АдресВХОбработки = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

	ПараметрыЗапуска = Новый Структура;
	ПараметрыЗапуска.Вставить("ИмяФайла", "");
	ПараметрыЗапуска.Вставить("Режим", Режим);
	ПараметрыЗапуска.Вставить("ФильтрЛС", АдаптНомерЛСДляАдреснойДиагностики);
	ПараметрыЗапуска.Вставить("ФильтрДокумента", АдаптНомерДокументаДляАдреснойДиагностики);

	СтруктураФоновогоЗадания = Адапт_ВыполнитьФоновоеЗаданиеНаСервере(
		НаименованиеЗадания,
		ИмяМетода,
		ПараметрыЗапуска,
		"",
		АдресВХОбработки);

	МодульДлительныеОперацииКлиент = Вычислить("ДлительныеОперацииКлиент");
	ПараметрыОжидания = МодульДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	ПараметрыОжидания.Интервал = 1;
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"Адапт_ВыполнитьНовыеСчетчикиВФоновомРежимеЗавершение",
		ЭтотОбъект,
		Режим);
	МодульДлительныеОперацииКлиент.ОжидатьЗавершение(
		СтруктураФоновогоЗадания,
		ОписаниеОповещения,
		ПараметрыОжидания);

КонецПроцедуры

&НаКлиенте
Процедура Адапт_ВыполнитьНовыеСчетчикиВФоновомРежимеЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		СообщитьПользователю("[7] Фоновая операция не вернула результат.");
		Возврат;
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда
		СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(Результат.АдресРезультата) Тогда
		СообщитьПользователю("[7] Фоновая операция завершилась без адреса результата.");
		Возврат;
	КонецЕсли;

	РезультатОперации = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	Если РезультатОперации = Неопределено Тогда
		СообщитьПользователю("[7] Не удалось получить результат из временного хранилища.");
		Возврат;
	КонецЕсли;

	Адапт_ПоказатьРезультатНовыхСчетчиков(РезультатОперации, ДополнительныеПараметры);

КонецПроцедуры

&НаКлиенте
Процедура Адапт_ПоказатьРезультатНовыхСчетчиков(РезультатОперации, Режим)

	Режим = НРег(СокрЛП(Строка(Режим)));
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("md");
	ТекстовыйФайл = Новый ЗаписьТекста(ИмяВременногоФайла, КодировкаТекста.UTF8);
	ТекстовыйФайл.Записать(РезультатОперации.ПолныйОтчет);
	ТекстовыйФайл.Закрыть();

	Если Режим = "diagnostic" Тогда
		ЗаголовокОповещения = ?(
			РезультатОперации.ЕстьПроблемы,
			"Диагностика новых счетчиков подготовлена",
			"Проблемы по новым счетчикам не обнаружены");
	ИначеЕсли Режим = "preview" Тогда
		ЗаголовокОповещения = ?(
			РезультатОперации.ЕстьПроблемы,
			"Preview новых счетчиков подготовлен",
			"Безопасных исправлений не найдено");
	Иначе
		ЗаголовокОповещения = ?(
			РезультатОперации.БылиИзменения,
			"Исправление новых счетчиков завершено",
			"Изменений не потребовалось");
	КонецЕсли;

	Состояние("[7] " + РезультатОперации.КраткийИтог);
	ПоказатьОповещениеПользователя(
		ЗаголовокОповещения,
		,
		РезультатОперации.КраткийИтог + Символы.ПС + ИмяВременногоФайла);
	ЗапуститьПриложение(ИмяВременногоФайла);

КонецПроцедуры

