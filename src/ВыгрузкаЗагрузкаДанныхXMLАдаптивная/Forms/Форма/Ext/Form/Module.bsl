Процедура Адапт_ДопСведенияВыборРеквизитаЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт

	Если РезультатВыполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекДанные = Элементы.ДополнительныеСведения.ТекущиеДанные;
	ТекДанные.КлючСвязиСОбъектом = ТекДанные.РегистрСведений + "." + РезультатВыполнения;
	ТекДанные.КлючСвязиСОбъектомМетаданныеОк = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ПериодВыгрузкиПриИзменении(Элемент)

	ЕстьОграничениеПоДатам = ЗначениеЗаполнено(ПериодВыгрузки.ДатаНачала)
		Или ЗначениеЗаполнено(ПериодВыгрузки.ДатаОкончания);
	Элементы.ИспользоватьОтборПоДатеДляВсехОбъектов.Доступность = ЕстьОграничениеПоДатам;
	Элементы.ТипВыгрузкиПериодическихРегистров.Доступность = ЕстьОграничениеПоДатам;

КонецПроцедуры

&НаКлиенте
Процедура Адапт_ДобавитьДополнительныеСведения(Команда)

	Адапт_ДобавитьДополнительныеСведенияСервер();
	Если ДополнительныеСведения.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Подсистема ""Дополнительные сведения"" отсутствует");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура Адапт_ДобавитьДополнительныеСведенияСервер()

	Если Метаданные.ОпределяемыеТипы.Найти("ВладелецДополнительныхСведений") = Неопределено
		ИЛИ Метаданные.РегистрыСведений.Найти("ДополнительныеСведения") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОбъектВыгрузки = "ОпределяемыйТип.ВладелецДополнительныхСведений";
	РегистрСведений = "ДополнительныеСведения";

	СтруктураОтбора = Новый Структура("ОбъектВыгрузки, РегистрСведений", ОбъектВыгрузки, РегистрСведений);

	НайденныеСтроки = ДополнительныеСведения.НайтиСтроки(СтруктураОтбора);
	Если НайденныеСтроки.Количество() = 0 Тогда
		НоваяСтрока = ДополнительныеСведения.Добавить();
		НоваяСтрока.ОбъектВыгрузки = ОбъектВыгрузки;
		НоваяСтрока.РегистрСведений = РегистрСведений;
		НоваяСтрока.КлючСвязиСОбъектом = "ДополнительныеСведения.Объект";

		НоваяСтрока.ОбъектВыгрузкиМетаданныеОк = Истина;
		НоваяСтрока.РегистрСведенийМетаданныеОк = Истина;
		НоваяСтрока.КлючСвязиСОбъектомМетаданныеОк = Истина;

	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеСведенияПослеУдаления(Элемент)
	Адапт_ПроверитьМетаданныеДопДанных();
КонецПроцедуры

&НаКлиенте
Процедура СвязиКлючейАналитикиПослеУдаления(Элемент)
	Адапт_ПроверитьМетаданныеДопДанных();
КонецПроцедуры

&НаКлиенте
Процедура ГруппаОбъектыВыгрузкиПриСменеСтраницы(Элемент, ТекущаяСтраница)

	Если ПредыдущаяСтраница = "ГруппаДополнительныеДанные" Тогда
		Адапт_ПроверитьМетаданныеДопДанных();
	КонецЕсли;

	ПредыдущаяСтраница = ТекущаяСтраница.Имя;

КонецПроцедуры

&НаКлиенте
Процедура СвязиКлючейАналитикиПриАктивизацииСтроки(Элемент)

	ТекДанные = Элементы.СвязиКлючейАналитики.ТекущиеДанные;

	Для каждого СтрокаТЧ Из СвязиКлючейАналитики Цикл
		СтрокаТЧ.ЭтоТекущаяСтрока = Ложь;
	КонецЦикла;

	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекДанные.ЭтоТекущаяСтрока = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеСведенияПриАктивизацииСтроки(Элемент)
	ТекДанные = Элементы.ДополнительныеСведения.ТекущиеДанные;

	Для каждого СтрокаТЧ Из ДополнительныеСведения Цикл
		СтрокаТЧ.ЭтоТекущаяСтрока = Ложь;
	КонецЦикла;

	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекДанные.ЭтоТекущаяСтрока = Истина;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьДубли(Команда)

	// 1. Спрашиваем подтверждение у пользователя, так как операция серьезная
	ТекстВопроса = "Внимание! Будет выполнен поиск и слияние дублей в ВЫБРАННЫХ справочниках.
	               |Все документы в базе будут переписаны на оригинальные объекты.
	               |Продолжить?";

	ОписаниеОповещения = Новый ОписаниеОповещения("УдалитьДублиЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьДублиЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		// 2. Запускаем серверную часть
		УдалитьДублиНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УдалитьДублиНаСервере()

	// 3. Превращаем данные формы в реальный объект обработки, чтобы вызвать метод модуля объекта
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

	// 4. Вызываем наш основной алгоритм
	ОбработкаОбъект.ВыполнитьУдалениеДублей();

КонецПроцедуры

#КонецОбласти

#Область Nexus_Template_Protocol

// ============================================================================
// СОХРАНЕНИЕ ШАБЛОНА (v2.0 с поддержкой дат)
// ============================================================================

&НаКлиенте
Функция Адапт_ПолучитьУникальныйПутьВДереве(СтрокаДерева)

	Путь = СтрокаДерева.ПолноеИмяМетаданных;
	ТекСтрока = СтрокаДерева.ПолучитьРодителя();

	Пока ТекСтрока <> Неопределено Цикл
		Путь = ТекСтрока.ПолноеИмяМетаданных + "." + Путь;
		ТекСтрока = ТекСтрока.ПолучитьРодителя();
	КонецЦикла;

	Возврат Путь;

КонецФункции

&НаКлиенте
Процедура Адапт_СохранитьШаблон(Команда)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Сохранить шаблон выгрузки";
	Диалог.Фильтр = "Файлы шаблонов (*.json)|*.json";
	Диалог.Расширение = "json";

	Оповещение = Новый ОписаниеОповещения("Адапт_СохранитьШаблонЗавершение", ЭтотОбъект);
	Диалог.Показать(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура Адапт_СохранитьШаблонЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПутьКФайлу = ВыбранныеФайлы[0];

	// Собираем отмеченные объекты
	МассивОтмеченных = Новый Массив;
	Адапт_СобратьОтмеченныеСтрокиДерева(Объект.ДеревоМетаданных.ПолучитьЭлементы(), МассивОтмеченных);

	Если МассивОтмеченных.Количество() = 0 Тогда
		ПоказатьПредупреждение(Неопределено, "Нет отмеченных объектов для сохранения!");
		Возврат;
	КонецЕсли;

	// Формируем структуру для сохранения (Галочки + Период)
	ДанныеШаблона = Новый Структура;
	ДанныеШаблона.Вставить("ОтмеченныеОбъекты", МассивОтмеченных);
	ДанныеШаблона.Вставить("ДатаНачала", ПериодВыгрузки.ДатаНачала);
	ДанныеШаблона.Вставить("ДатаОкончания", ПериодВыгрузки.ДатаОкончания);
	ДанныеШаблона.Вставить("ВыгружатьСДокументомЕгоДвижения", Объект.ВыгружатьСДокументомЕгоДвижения);

	// Сериализация в JSON
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеШаблона);
	СтрокаJSON = ЗаписьJSON.Закрыть();

	// Запись в файл
	ТекстовыйФайл = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	ТекстовыйФайл.Записать(СтрокаJSON);
	ТекстовыйФайл.Закрыть();

	ПоказатьОповещениеПользователя("Шаблон сохранен", , "Сохранено объектов: " + МассивОтмеченных.Количество());

КонецПроцедуры

&НаКлиенте
Процедура Адапт_СобратьОтмеченныеСтрокиДерева(ЭлементыДерева, МассивОтмеченных)

	Для Каждого Строка Из ЭлементыДерева Цикл
		Если Строка.Выгружать = 1 Тогда
			// ИСПРАВЛЕНИЕ: Сохраняем полный уникальный путь вместо короткого имени
			МассивОтмеченных.Добавить(Адапт_ПолучитьУникальныйПутьВДереве(Строка));
		КонецЕсли;

		ЭлементыПодчиненные = Строка.ПолучитьЭлементы();
		Если ЭлементыПодчиненные.Количество() > 0 Тогда
			Адапт_СобратьОтмеченныеСтрокиДерева(ЭлементыПодчиненные, МассивОтмеченных);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура Адапт_ЗагрузитьШаблон(Команда)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите файл шаблона";
	Диалог.Фильтр = "Файлы шаблонов (*.json)|*.json";

	Оповещение = Новый ОписаниеОповещения("Адапт_ЗагрузитьШаблонЗавершение", ЭтотОбъект);
	Диалог.Показать(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура Адапт_ЗагрузитьШаблонЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПутьКФайлу = ВыбранныеФайлы[0];

	Попытка
		ТекстовыйФайл = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
		СтрокаJSON = ТекстовыйФайл.Прочитать();
		ТекстовыйФайл.Закрыть();

		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
		ДанныеШаблона = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
	Исключение
		ПоказатьПредупреждение(Неопределено, "Ошибка чтения файла шаблона: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	МассивОтмеченных = Новый Массив;

	// Обработка структуры (Новый формат v2.0)
	Если ТипЗнч(ДанныеШаблона) = Тип("Структура") Тогда
		МассивОтмеченных = ДанныеШаблона.ОтмеченныеОбъекты;
		Если ДанныеШаблона.Свойство("ВыгружатьСДокументомЕгоДвижения") Тогда
			Объект.ВыгружатьСДокументомЕгоДвижения = ДанныеШаблона.ВыгружатьСДокументомЕгоДвижения;
		КонецЕсли;

		// Восстанавливаем период (JSON читает даты как строки ISO, конвертируем их)
		Попытка
			Если ЗначениеЗаполнено(ДанныеШаблона.ДатаНачала) Тогда
				ПериодВыгрузки.ДатаНачала = XMLЗначение(Тип("Дата"), ДанныеШаблона.ДатаНачала);
			Иначе
				ПериодВыгрузки.ДатаНачала = '00010101';
			КонецЕсли;

			Если ЗначениеЗаполнено(ДанныеШаблона.ДатаОкончания) Тогда
				ПериодВыгрузки.ДатаОкончания = XMLЗначение(Тип("Дата"), ДанныеШаблона.ДатаОкончания);
			Иначе
				ПериодВыгрузки.ДатаОкончания = '00010101';
			КонецЕсли;

			// Обновляем доступность элементов формы, зависящих от периода
			ПериодВыгрузкиПриИзменении(Неопределено);
		Исключение
			// Игнорируем ошибку конвертации дат, главное загрузить галочки
		КонецПопытки;

	// Обработка массива (Старый формат v1.0 для обратной совместимости)
	ИначеЕсли ТипЗнч(ДанныеШаблона) = Тип("Массив") Тогда
		МассивОтмеченных = ДанныеШаблона;
	Иначе
		ПоказатьПредупреждение(Неопределено, "Неверный формат файла шаблона!");
		Возврат;
	КонецЕсли;

	// Сбрасываем все текущие галочки
	Адапт_СброситьВсеГалочкиДерева(Объект.ДеревоМетаданных.ПолучитьЭлементы());

	// Устанавливаем новые галочки
	СчетчикУстановленных = 0;
	Адапт_УстановитьГалочкиПоМассиву(Объект.ДеревоМетаданных.ПолучитьЭлементы(), МассивОтмеченных, СчетчикУстановленных);

	ПоказатьОповещениеПользователя("Шаблон загружен", , "Восстановлено объектов: " + СчетчикУстановленных);

КонецПроцедуры

&НаКлиенте
Процедура Адапт_СброситьВсеГалочкиДерева(ЭлементыДерева)

	Для Каждого Строка Из ЭлементыДерева Цикл
		Строка.Выгружать = 0;
		ЭлементыПодчиненные = Строка.ПолучитьЭлементы();
		Если ЭлементыПодчиненные.Количество() > 0 Тогда
			Адапт_СброситьВсеГалочкиДерева(ЭлементыПодчиненные);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура Адапт_УстановитьГалочкиПоМассиву(ЭлементыДерева, МассивОтмеченных, СчетчикУстановленных)

	Для Каждого Строка Из ЭлементыДерева Цикл

		// ИСПРАВЛЕНИЕ: Ищем по полному уникальному пути
		УникальныйПуть = Адапт_ПолучитьУникальныйПутьВДереве(Строка);

		Если МассивОтмеченных.Найти(УникальныйПуть) <> Неопределено Тогда
			Строка.Выгружать = 1;
			СчетчикУстановленных = СчетчикУстановленных + 1;

			УстановитьПометкиРодителей(Строка, "Выгружать");
		КонецЕсли;

		ЭлементыПодчиненные = Строка.ПолучитьЭлементы();
		Если ЭлементыПодчиненные.Количество() > 0 Тогда
			Адапт_УстановитьГалочкиПоМассиву(ЭлементыПодчиненные, МассивОтмеченных, СчетчикУстановленных);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
