&НаКлиенте
Процедура ИсправитьСтруктуруПомещенийЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ОчиститьСообщения();
	Состояние("Выполняется исправление структуры помещений. Пожалуйста, подождите...");

	Если Адапт_ЗапуститьДолгуюОперациюВФоновомРежиме("ИсправитьСтруктуруПомещенийНаСервере") Тогда
		Возврат;
	КонецЕсли;

	РезультатИсправления = ИсправитьСтруктуруПомещенийНаСервере();
	Если РезультатИсправления = Неопределено Тогда
		СообщитьПользователю("Не удалось получить результат исправления структуры помещений.");
		Возврат;
	КонецЕсли;

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("md");
	ТекстовыйФайл = Новый ЗаписьТекста(ИмяВременногоФайла, КодировкаТекста.UTF8);
	ТекстовыйФайл.Записать(РезультатИсправления.ПолныйОтчет);
	ТекстовыйФайл.Закрыть();

	ЗаголовокОповещения = ?(РезультатИсправления.БылиИзменения, "Исправление структуры помещений завершено", "Изменений не потребовалось");
	ПоказатьОповещениеПользователя(ЗаголовокОповещения, , РезультатИсправления.КраткийИтог + Символы.ПС + ИмяВременногоФайла);
	ЗапуститьПриложение(ИмяВременногоФайла);

КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьСвязиЛСИУслугЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ОчиститьСообщения();
	Состояние("Выполняется восстановление связей лицевых счетов и услуг. Пожалуйста, подождите...");

	Если Адапт_ЗапуститьДолгуюОперациюВФоновомРежиме("ВосстановитьСвязиЛСИУслугНаСервере") Тогда
		Возврат;
	КонецЕсли;

	РезультатВосстановления = ВосстановитьСвязиЛСИУслугНаСервере();
	Если РезультатВосстановления = Неопределено Тогда
		СообщитьПользователю("Не удалось получить результат восстановления связей лицевых счетов и услуг.");
		Возврат;
	КонецЕсли;

	РасширениеФайла = "md";
	Если РезультатВосстановления.Свойство("РасширениеФайла") Тогда
		РасширениеФайла = РезультатВосстановления.РасширениеФайла;
	КонецЕсли;

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(РасширениеФайла);
	ТекстовыйФайл = Новый ЗаписьТекста(ИмяВременногоФайла, КодировкаТекста.UTF8);
	ТекстовыйФайл.Записать(РезультатВосстановления.ПолныйОтчет);
