&НаСервере
Процедура Адапт_ЗаполнитьКлючиАналитикиСервер()

	Массив = Новый Массив;

	КлючАналитики = "КлючиАналитикиУчетаНаборов";
	РегистрДвижений = "АналитикаУчетаНаборов";
	Массив.Добавить(Новый Структура("КлючАналитики, РегистрДвижений", КлючАналитики, РегистрДвижений));

	КлючАналитики = "КлючиАналитикиУчетаНоменклатуры";
	РегистрДвижений = "АналитикаУчетаНоменклатуры";
	Массив.Добавить(Новый Структура("КлючАналитики, РегистрДвижений", КлючАналитики, РегистрДвижений));

	КлючАналитики = "КлючиАналитикиУчетаПартий";
	РегистрДвижений = "АналитикаУчетаПартий";
	Массив.Добавить(Новый Структура("КлючАналитики, РегистрДвижений", КлючАналитики, РегистрДвижений));

	КлючАналитики = "КлючиАналитикиУчетаПоПартнерам";
	РегистрДвижений = "АналитикаУчетаПоПартнерам";
	Массив.Добавить(Новый Структура("КлючАналитики, РегистрДвижений", КлючАналитики, РегистрДвижений));

	КлючАналитики = "КлючиАналитикиУчетаЗатрат";
	РегистрДвижений = "АналитикаУчетаЗатрат";
	Массив.Добавить(Новый Структура("КлючАналитики, РегистрДвижений", КлючАналитики, РегистрДвижений));

	КлючАналитики = "КлючиАналитикиУчетаНДС";
	РегистрДвижений = "АналитикаУчетаНДС";
	Массив.Добавить(Новый Структура("КлючАналитики, РегистрДвижений", КлючАналитики, РегистрДвижений));

	Для каждого Структура Из Массив Цикл
		КлючАналитики = "Справочник." + Структура.КлючАналитики;
		РегистрДвижений = "РегистрСведений." + Структура.РегистрДвижений;

		Если Адапт_ЕстьСвойство(Справочники, Структура.КлючАналитики)
			И Адапт_ЕстьСвойство(РегистрыСведений, Структура.РегистрДвижений) Тогда

			СтруктураОтбора = Новый Структура("КлючАналитики, РегистрДвижений", КлючАналитики, РегистрДвижений);
			НайденныеСтроки = СвязиКлючейАналитики.НайтиСтроки(СтруктураОтбора);
			Если НайденныеСтроки.Количество() = 0 Тогда
				НоваяСтрока = СвязиКлючейАналитики.Добавить();
				НоваяСтрока.КлючАналитики   = КлючАналитики;
				НоваяСтрока.РегистрДвижений = РегистрДвижений;
			КонецЕсли;

		КонецЕсли;
	КонецЦикла;

	Адапт_ПроверитьМетаданныеДопДанных();

КонецПроцедуры

