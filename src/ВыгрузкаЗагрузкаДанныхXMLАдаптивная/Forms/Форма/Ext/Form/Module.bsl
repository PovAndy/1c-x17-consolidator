&НаКлиенте
Процедура АнализСтруктурыБазы(Команда)

	ОчиститьСообщения();
	Состояние("Выполняется анализ структуры базы. Пожалуйста, подождите...");

	Если Адапт_ЗапуститьДолгуюОперациюВФоновомРежиме("АнализСтруктурыБазыНаСервере") Тогда
		Возврат;
	КонецЕсли;

	РезультатАнализа = АнализСтруктурыБазыНаСервере();
	Если РезультатАнализа = Неопределено Тогда
		СообщитьПользователю("Не удалось получить результат анализа структуры базы.");
		Возврат;
	КонецЕсли;

	РасширениеФайла = "md";
	Если РезультатАнализа.Свойство("РасширениеФайла") Тогда
		РасширениеФайла = РезультатАнализа.РасширениеФайла;
	КонецЕсли;

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(РасширениеФайла);
	ТекстовыйФайл = Новый ЗаписьТекста(ИмяВременногоФайла, КодировкаТекста.UTF8);
	ТекстовыйФайл.Записать(РезультатАнализа.ПолныйОтчет);
	ТекстовыйФайл.Закрыть();

	Если РезультатАнализа.ЕстьПроблемы Тогда
		ПоказатьОповещениеПользователя("Анализ структуры базы завершен", , РезультатАнализа.КраткийИтог + Символы.ПС + ИмяВременногоФайла);
	Иначе
		ПоказатьОповещениеПользователя("Структура базы проверена", , РезультатАнализа.КраткийИтог + Символы.ПС + ИмяВременногоФайла);
	КонецЕсли;

	ЗапуститьПриложение(ИмяВременногоФайла);

КонецПроцедуры

