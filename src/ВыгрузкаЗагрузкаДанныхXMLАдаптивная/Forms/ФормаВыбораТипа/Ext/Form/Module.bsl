КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПоиск(ЗначениеПоиска) Экспорт 
	
	Если ЗначениеЗаполнено(ЗначениеПоиска) Тогда
			ПоказатьРезультатыПоиска();
	Иначе
		Элементы.Дерево.Видимость = Истина;
		Элементы.Найдено.Видимость = Ложь;
	КонецЕсли;
	
	Если ТекущийЭлемент = Элементы.Поиск Тогда
		Элементы.Поиск.СочетаниеКлавиш = Новый СочетаниеКлавиш(Клавиша.Нет);
	Иначе
		Элементы.Поиск.СочетаниеКлавиш = Новый СочетаниеКлавиш(Клавиша.Space);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьРезультатыПоиска() 
	
	Элементы.Дерево.Видимость = Ложь;
	Элементы.ГруппаКвалификаторы.Видимость = Ложь;
	Элементы.Найдено.Видимость = Истина;
	Найдено.ПолучитьЭлементы().Очистить();
	
	МассивСлов = СтрРазделить(Элементы.Поиск.ТекстРедактирования, " ", Ложь);
	Если МассивСлов.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	Если ОсновноеПредставление = "По имени" Тогда
		ЗаполнитьНайдено(Дерево.ПолучитьЭлементы(), "Имя", МассивСлов);
	Иначе
		ЗаполнитьНайдено(Дерево.ПолучитьЭлементы(), "Синоним", МассивСлов);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНайдено(КоллекцияСтрок, ИмяСвойства, МассивСлов) 
	
	Перем СтрокиНайдено;
	
	Для каждого Строка Из КоллекцияСтрок Цикл
		
		Если Строка.ЭтоГруппа Тогда
			ЗаполнитьНайдено(Строка.ПолучитьЭлементы(), ИмяСвойства, МассивСлов);
			Продолжить;
		КонецЕсли;
		
		ИсходнаяСтрока = НРег(Строка[ИмяСвойства]);
		
		НайденоВСтроке = Истина;
		Для Сч = 0 По МассивСлов.ВГраница() Цикл
			Если СтрНайти(ИсходнаяСтрока, МассивСлов[Сч]) = 0 Тогда
				НайденоВСтроке = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НайденоВСтроке = Истина Тогда
			Если СтрокиНайдено = Неопределено Тогда
				СтрокиНайдено = Найдено.ПолучитьЭлементы();
			КонецЕсли;
			НовСтрока = СтрокиНайдено.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, Строка);
			НовСтрока.КлючСвязиДерево = Строка.ПолучитьИдентификатор();
			НовСтрока.Имя = Новый ФорматированнаяСтрока(НовСтрока.Имя, , WebЦвета.ЗеленаяЛужайка);
		КонецЕсли;
		
		Строки = Строка.ПолучитьЭлементы();
		Если Строки.Количество() > 0 Тогда
			ЗаполнитьНайдено(Строки, ИмяСвойства, МассивСлов);
		КонецЕсли;
		
	КонецЦикла;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элемент.ТекущиеДанные;
	
	Если ТекДанные.ЭтоГруппа = Ложь И (
		Элемент.ТекущийЭлемент = Элементы.ДеревоИмя Или 
		Элемент.ТекущийЭлемент = Элементы.ДеревоСиноним) Тогда
		
		Если Составной Тогда
			Пометка = ТекДанные.Пометка;
			
			Если ТекДанные.ЭтоГруппа = Ложь И Составной = Ложь Тогда
				СнятьВсеПометки(Дерево.ПолучитьЭлементы());
			КонецЕсли;
			
			ТекДанные.Пометка = Не Пометка;
			
		Иначе
			СнятьВсеПометки(Дерево.ПолучитьЭлементы());
			ВыбратьИЗакрыть();
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АктивизироватьПолеПоиска(Команда)
	
	Если ТекущийЭлемент = Элементы.Поиск Тогда
		Возврат;	
	КонецЕсли;
	
	ТекущийЭлемент = Элементы.Поиск;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоискАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	ВыполнитьПоиск(Текст);
	Если Не ЗначениеЗаполнено(Текст) Тогда
		ОбновитьЭлементыПослеЗавершенияПоиска();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НайденоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Составной Тогда
		Элементы.Дерево.ТекущаяСтрока = Элементы.Найдено.ТекущиеДанные.КлючСвязиДерево;
	
		ОбновитьЭлементыПослеЗавершенияПоиска();
	Иначе
		Ид = Элементы.Найдено.ТекущиеДанные.КлючСвязиДерево;
		Элементы.Дерево.ТекущаяСтрока = Ид;
		Дерево.НайтиПоИдентификатору(Ид).Пометка = Истина;
		ВыбратьИЗакрыть();
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПоискОчистка(Элемент, СтандартнаяОбработка)
	
	ОбновитьЭлементыПослеЗавершенияПоиска();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЭлементыПослеЗавершенияПоиска() 
	
	Элементы.Поиск.СочетаниеКлавиш = Новый СочетаниеКлавиш(Клавиша.Space);
	Элементы.Дерево.Видимость = Истина;
	Элементы.Найдено.Видимость = Ложь;
	Элементы.ГруппаКвалификаторы.Видимость = Истина;
	
	Поиск = "";
	
КонецПроцедуры
