# Пример файла .env.openrouter.local
# Реальные значения хранятся только локально и никогда не публикуются.
# Скопируйте этот файл в .env.openrouter.local и заполните своими ключами.

# OMVL: ролевые контуры (только псевдонимы, ключ/модель — в центральном реестре ниже)

# Librarian: локальный Gemini CLI, затем OpenRouter free/paid Qwen
OR_LIBRARIAN_GEMINI_PRO=
OR_LIBRARIAN_GEMINI_FLASH=
OR_LIBRARIAN_FREE_MODEL=
OR_LIBRARIAN_PAID_MODEL=

# Critic (QA): BSL Critic
OR_CRITIC_FREE_MODEL=
OR_CRITIC_PAID_MODEL=

# Scribe: Markdown
OR_SCRIBE_MODEL=

# Forensics: SQL
OR_FORENSICS_MODEL=

# --- Центральный реестр ключей/моделей (строгие пары) ---

# Код-индекс (code-index) — выделенный контур, слоты-пары ключ+модель
OR_KEY_CODE_INDEX_01=
OR_MODEL_CODE_INDEX_01=
OR_KEY_CODE_INDEX_02=
OR_MODEL_CODE_INDEX_02=
OR_KEY_CODE_INDEX_03=
OR_MODEL_CODE_INDEX_03=
OR_KEY_CODE_INDEX_04=
OR_MODEL_CODE_INDEX_04=
OR_KEY_CODE_INDEX_05=
OR_MODEL_CODE_INDEX_05=