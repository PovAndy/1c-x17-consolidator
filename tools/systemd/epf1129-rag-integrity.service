[Unit]
Description=EPF1129 RAG indexes synchronization and integrity check
Documentation=file://{PROJECT_ROOT}/docs/WORKSPACE_ARCHITECTURE_CURRENT.md

[Service]
Type=oneshot
WorkingDirectory={PROJECT_ROOT}
ExecStart={PROJECT_ROOT}/.venv-gemini-bridge/bin/python {PROJECT_ROOT}/scripts/kb_manager.py --reindex
ExecStartPost={PROJECT_ROOT}/.venv-gemini-bridge/bin/python {PROJECT_ROOT}/scripts/kb_manager.py --validate
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
MemoryMax=256M
CPUQuota=40%
